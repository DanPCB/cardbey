/** Guest JWT for cardbey.com performer (cross-origin dashboard → core). Required for mission polling without sign-in. */
GUEST_AUTH_ENABLED=1
# Canonical file on disk: apps/core/cardbey-core/prisma/dev.db
# Canonical URL (from apps/core/cardbey-core/): file:./prisma/dev.db
DATABASE_URL=file:./prisma/dev.db

# OAuth Providers (optional - set at least one to enable OAuth)
FACEBOOK_CLIENT_ID=\\
FACEBOOK_CLIENT_SECRET=\\
# Aliases: FACEBOOK_APP_ID / FACEBOOK_APP_SECRET
FACEBOOK_REDIRECT_URI=\http://localhost:3001/api/oauth/facebook/callback\

# Zalo Official Account OAuth (optional)
ZALO_APP_ID=\\
ZALO_APP_SECRET=\\
ZALO_REDIRECT_URI=\http://localhost:3001/api/oauth/zalo/callback\

TIKTOK_CLIENT_KEY=\\
TIKTOK_CLIENT_SECRET=\\
TIKTOK_REDIRECT_URI=\http://localhost:3001/oauth/tiktok/callback\

TWITTER_CLIENT_ID=\\
TWITTER_CLIENT_SECRET=\\
TWITTER_REDIRECT_URI=\http://localhost:3001/oauth/twitter/callback\

# Dev only: Fake OAuth provider (for local testing without real credentials)
# Set to 1 to enable a fake \dev\ provider that shows as configured
# Automatically disabled in production (NODE_ENV=production)
OAUTH_DEV_FAKE=0

# Public URLs (playlist/media bases). getBaseUrlFromRequest prefers Host over env; set API base for CLI/no-Host fallbacks.
# Example LAN API: PUBLIC_API_BASE_URL=http://192.168.1.11:3001
# PUBLIC_BASE_URL=...

# Marketing SPA (dashboard + public storefront links /s/:slug).
# Local dev: use your dashboard origin so publish links point at localhost (e.g. http://localhost:5174).
# Staging/prod: set to the public marketing hostname (e.g. https://www.cardbey.com). Do not use production URL in local .env or publish links will target prod while data stays on SQLite.
PUBLIC_APP_URL=http://localhost:5174
# Optional alias if PUBLIC_APP_URL is unset:
# DASHBOARD_URL=http://localhost:5174

# Frontend URL for email links / UI redirects (change in production)
FRONTEND_PUBLIC_URL=http://localhost:5174

# API origin for email verification links (dev)
EMAIL_VERIFICATION_API_ORIGIN=http://localhost:3001

# Dev-only convenience: auto-verify accounts (skip email verification gate)
SKIP_EMAIL_VERIFICATION=true

# Server Configuration
PORT=3001
NODE_ENV=development
ROLE=api

# Runtime boundary (Phase 1 locator - optional). Writers are not cut over yet.
# When set, preferred runtime paths resolve under this root (area suffixes apply).
# Precedence: area-specific env (e.g. UPLOADS_DIR) -> CARDBEY_RUNTIME_ROOT -> platform default.
# Local default (non-test): ~/.cardbey/runtime
# Test default: os.tmpdir()/cardbey-runtime-test/<worker>
# Prod with disk: $PERSISTENT_DISK_PATH/cardbey-runtime
# See docs/RUNTIME_BOUNDARY_PLAN.md and docs/IMPACT_REPORT_RUNTIME_LOCATOR_PHASE_1.md
# CARDBEY_RUNTIME_ROOT=

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174,http://127.0.0.1:5174,http://192.168.1.7:5174

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Contact Sync (Phase 1 MVP)
# Server-controlled keyed HMAC secret (do NOT commit real value). Required to enable contact sync APIs.
CONTACT_SYNC_HMAC_SECRET=change-me

# Phase 2 draft guardrails: vertical image filter + de-generic item names (default off until validated)
ENABLE_DRAFT_GUARDS=false

# CTA Engine — capability discovery + ranking (default on). Storefront primary resolve always available.
# ENABLE_CTA_ENGINE_V1=true
# Phase 2 platform marketing consumer (/for-business). Default on in non-prod, off in production.
# ENABLE_CTA_ENGINE_PLATFORM_MARKETING_V1=true

# Intake consolidation — store creation always uses kernel dispatch (see createStoreCheckpointDispatch.js)
ENABLE_STORE_TARGETID_BACKFILL=false
ENABLE_MISSION_HANDOFF=false
# Dashboard: VITE_ENABLE_MISSION_HANDOFF=true (pairs with ENABLE_MISSION_HANDOFF on core)

# Runtime Kernel — EXECUTION_MODE is the canonical authority switch (Phase 9)
# kernel   — production default; full kernel enforcement
# hybrid   — transitional; kernel on, broker direct block relaxed
# legacy   — rollback only; logs deprecation warnings
EXECUTION_MODE=kernel
#
# Deprecated authority flags (ignored when EXECUTION_MODE is set; use EXECUTION_MODE instead):
# DISABLE_RUNTIME_KERNEL=true
# DISABLE_RUNTIME_STEP_EXECUTION=true
# DISABLE_SHARED_RUNTIME_TOOL_REGISTRY=true
# Context Engine — set true to fall back to client-only currentContext (Phase A rollback)
# DISABLE_CONTEXT_ENGINE=true
# Learning Layer (Phase D) — intent confidence calibration + personalization
# ENABLE_LEARNING_LAYER=true
# DISABLE_LEARNING_LAYER=true

# ============================================================
# Performer mode (Phase 1)
# ============================================================
# Default mode when client omits X-Performer-Mode / body.mode.
# automation — full reasoning pipeline (Input → Read → Reason → Explain → Execute)
# manual — skip reasoning; explicit actions only (governance still enforced)
PERFORMER_DEFAULT_MODE=automation

# ============================================================
# Phase B.3 — Intent Reasoning (always enabled)
# ============================================================

# Enable reasoning trace (development only)
INTENT_REASONER_TRACE_ENABLED=false

# Minimum confidence threshold for execution (0.0-1.0)
INTENT_REASONER_MIN_CONFIDENCE=0.7

# Maximum reasoning time in milliseconds
INTENT_REASONER_MAX_TIME_MS=2000

# Intake belief shadow (read-only; default on). Set false to disable.
# INTAKE_BELIEF_SHADOW_ENABLED=true
# INTAKE_BELIEF_SHADOW_LOG=true
# INTAKE_BYPASS_TELEMETRY_LOG=true

# Advisor shadow rank vs IntentReasoner (default on with belief shadow)
# INTAKE_ADVISOR_SHADOW_ENABLED=true
# INTAKE_ADVISOR_SHADOW_LOG=true

# LLM Reasoner — AI-first intent detection on Intake V2 (IntentReasoner remains fallback)
# Multi-agent intent-to-artifact compiler rollout
USE_COMPILER_FOR_CAMPAIGNS=false
USE_COMPILER_FOR_STORES=false
# When true: loyalty card scan → IntentReasoner → compileWithMultiAgent → writeMetadata (TopologyReview). Default false keeps runtime ui-action.
USE_LOYALTY_SPINE=false

# LLM reasoner — enabled by default; set ENABLE_LLM_REASONER=false to disable
# ENABLE_LLM_REASONER=false
# ENABLE_LLM_REASONER=false

# ReAct step reflection during multi-step missions — enabled by default; set USE_REACT_REFLECTION=false to disable
# USE_REACT_REFLECTION=false

# Memory facade load timeout for kernel step injection (ms)
# MEMORY_LOAD_TIMEOUT_MS=2000

# Dashboard unified dispatch delegates to POST /api/performer/dispatch (default on)
# USE_BACKEND_DISPATCH=false
LLM_REASONER_ROLLOUT_PERCENTAGE=0
LLM_REASONER_MAX_TOKENS=2000
LLM_REASONER_TEMPERATURE=0.3
LLM_REASONER_TIMEOUT_MS=15000
# Conversation turns passed to LLM reasoner (server-side; default 15 when ENABLE_LLM_REASONER=true)
LLM_REASONER_MAX_HISTORY_TURNS=15
LLM_REASONER_MAX_TURN_LENGTH=1000
# Observability (prompt size + memory allocation logging)
LLM_REASONER_LOG_PROMPT_BYTES=true
LLM_REASONER_LOG_MEMORY_USAGE=true
LLM_REASONER_TELEMETRY_ENABLED=true
# Optional provider/model overrides (otherwise llmGateway defaults apply)
# LLM_REASONER_PROVIDER=anthropic
# LLM_REASONER_MODEL=claude-sonnet-4-6

# LLM Tool Loop (ReAct read-only context gathering before final intent)
ENABLE_LLM_TOOL_LOOP=false
LLM_TOOL_LOOP_MAX_ITERATIONS=3
LLM_TOOL_LOOP_MAX_RESULT_SIZE=4096
# Comma-separated allowlist override (defaults to mcp_context_* + get_store_analytics + market_research)
# LLM_TOOL_LOOP_ALLOWLIST=mcp_context_analytics,get_store_analytics

# Extended Thinking (Anthropic — requires ENABLE_LLM_REASONER=true and anthropic provider)
ENABLE_LLM_THINKING=false
LLM_THINKING_BUDGET=4096
LLM_THINKING_MODEL=claude-sonnet-4-6

# Fast path — skip LLM for greetings and very short messages (deterministic IntentReasoner only)
# DISABLE_LLM_REASONER_FAST_PATH=true
LLM_REASONER_FAST_PATH_MAX_WORDS=3

# ============================================================
# RAG in Performer LLMReasoner
# ============================================================
# Enable RAG retrieval to ground LLMReasoner in store docs/reports (requires ENABLE_LLM_REASONER=true)
ENABLE_RAG_IN_REASONER=false
# Skip RAG for imperative actions (create, set up, help me…)
RAG_EXCLUDE_IMPERATIVE_ACTIONS=true
RAG_MAX_CHUNKS=5
RAG_MIN_SCORE=0.6
RAG_TIMEOUT_MS=3000

# ============================================================
# LLM Gateway — Multi-Message + Tool Calling
# ============================================================
# Phase 0: gateway is ON by default. Set false only to rollback to direct SDKs.
# USE_LLM_GATEWAY=false
# Provider selection (anthropic | openai | deepseek | xai | kimi | groq)
LLM_DEFAULT_PROVIDER=anthropic
LLM_FALLBACK_PROVIDER=openai
# Default Anthropic model (also set under ANTHROPIC_MODEL / CODE_FIX below)
# LLM_DEFAULT_MODEL=claude-sonnet-4-6
# OpenAI-family fallback used by engines / gateway fallback
LLM_FALLBACK_MODEL=gpt-4o-mini
# Phase 1: PII redaction before external provider calls (default ON)
# ENABLE_PII_REDACTION=false

# Phase 3–4: multimodal + embeddings facades (default ON; set false to rollback to direct providers)
# Phase 4 removed orphan lib/llm/hybridRouter + cloudAdapter (routing hybridRouter is unrelated and kept).
# VISION_ENABLED=false
VISION_PROVIDER=anthropic
VISION_FALLBACK_PROVIDER=openai
# EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=openai
EMBEDDING_FALLBACK_PROVIDER=voyage
# VOYAGE_API_KEY=
# COHERE_API_KEY=
# IMAGE_GEN_ENABLED=false
IMAGE_PROVIDER=dalle
IMAGE_FALLBACK_PROVIDER=ideogram
# VIDEO_GEN_ENABLED=false
VIDEO_PROVIDER=openai
VIDEO_FALLBACK_PROVIDER=kling

# Kimi / Moonshot (gateway provider: kimi)
KIMI_ENABLED=true
KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_DEFAULT_MODEL=kimi-k2.5
# KIMI_DISABLED=true

# Groq (gateway provider: groq) — retires legacy hybrid path for new traffic
GROQ_ENABLED=true
# GROQ_API_KEY=  (also listed under Additional LLM providers below)
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant

# Native tool calling (disable to fall back to prompt-only JSON tool loop)
LLM_TOOL_CALLING_ENABLED=true
LLM_TOOL_CALLING_MAX_ITERATIONS=5
# Multi-message limits
LLM_MAX_MESSAGES=50
LLM_MAX_CONTEXT_TOKENS=32000

# Compare reasoner vs legacy classifier in logs (development diagnostics)
INTENT_REASONER_PARITY_MODE=false

# Enable Dynamic Planner (generates blackboard-ready step plans from reasoned intent)
ENABLE_DYNAMIC_PLANNER=false

# Allow dynamic planner to run when legacy classifier was used (no Intent Reasoner)
ENABLE_DYNAMIC_PLANNER_LEGACY=false

# Execute dynamic plans via runtime orchestrator (Phase C.3; requires ENABLE_DYNAMIC_PLANNER=true)
ENABLE_DYNAMIC_PLANNER_EXECUTION=false

# Disable auto mission creation for quick actions (rollback for quick-action mission fix)
# DISABLE_QUICK_ACTION_MISSION_CREATION=true

# EMERGENCY_BYPASS_KERNEL=true
# BROKER_BLOCK_DIRECT_ACTION=false
# BROKER_DIRECT_VIA_FACADE=true
# PERFORMER_RUNTIME_ENABLED=true
# PERFORMER_RUNTIME_PIPELINE_FACADE=true
#
# ============================================================
# DIAGNOSTICS — store creation / kernel dispatch tracing
# ============================================================
# LOG_LLM_REASONER_DIAGNOSTICS=true
# LOG_KERNEL_DISPATCH_DIAGNOSTICS=true
# LOG_INTAKE_DIAGNOSTICS=true
# BYPASS_KERNEL_FOR_CREATE_STORE=true
#
# Store checkpoint pipeline routes through executeRuntimeAction → create_store tool (kernel_dispatch).
# Pipeline step advancement always uses kernel when EXECUTION_MODE=kernel.

# Creative Factory V1 — route video/creative intents through Factory Runtime (rollback: ENABLE_CREATIVE_FACTORY_V1=false)
ENABLE_CREATIVE_FACTORY_V1=true
# Creative Factory V2 — research → script → asset search → video plan pipeline (default off)
ENABLE_CREATIVE_FACTORY_V2=false
# Creative Factory V3 — subtitles, music, final review, publish handoff (fallback: V3 → V2 → V1)
ENABLE_CREATIVE_FACTORY_V3=false
# Creative Factory V4 — multi-scene render + governed publish (fallback: V4 → V3 → V2 → V1)
ENABLE_CREATIVE_FACTORY_V4=false
# Universal Artifact Factory — one pipeline for all artifact types (default on in dev/staging)
ENABLE_UNIVERSAL_ARTIFACT_FACTORY=false
# Campaign Package Factory V1 — tool-only factory proof via POST /api/performer/runtime/run-factory
ENABLE_CAMPAIGN_PACKAGE_FACTORY=false

# Runtime Session Rehydration — Performer mount/refresh authority (rollback: set ENABLE_RUNTIME_SESSION_REHYDRATION=false)
ENABLE_RUNTIME_SESSION_REHYDRATION=false
ENABLE_RUNTIME_STORE_FALLBACK=false
ENABLE_RUNTIME_MISSION_RESUME=false
# Runtime Prerequisite Resolution — block proactive steps until store/target is explicitly resolved
ENABLE_RUNTIME_PREREQUISITE_RESOLUTION=false
# Runtime Target Readiness — operational state guidance (publish/campaign/device next steps)
ENABLE_RUNTIME_TARGET_READINESS=false
# Runtime Mission Orchestrator — backend proactive step sequencing (Phase B)
ENABLE_RUNTIME_MISSION_ORCHESTRATOR=false
# Runtime Mission Graph — persistent graph orchestration (Phase C; rollback: set both false)
ENABLE_RUNTIME_MISSION_GRAPH=false
ENABLE_RUNTIME_GRAPH_SCHEDULER=false
# Runtime Skill / Worker execution (Phase D; rollback: set all three false → Phase C graph execution)
ENABLE_RUNTIME_SKILL_RUNTIME=false
ENABLE_RUNTIME_WORKER_MANAGER=false
ENABLE_RUNTIME_EXECUTION_LEASES=false
# Durable execution queue + recovery (Phase E; rollback: set all four false → Phase D)
ENABLE_RUNTIME_EXECUTION_QUEUE=false
ENABLE_RUNTIME_LEASE_RECOVERY=false
ENABLE_RUNTIME_REPLAY_PROTECTION=false
ENABLE_RUNTIME_HEARTBEAT_MONITOR=false
# Dashboard: VITE_ENABLE_RUNTIME_SESSION_REHYDRATION=true
# Dashboard: VITE_ENABLE_RUNTIME_STORE_FALLBACK=true
# Dashboard: VITE_ENABLE_RUNTIME_MISSION_RESUME=true

# Runtime capabilities negotiation: GET /api/runtime/capabilities (no VITE_* mirror required — dashboard fetches from core at boot)
# Staging rollout template: .env.staging.runtime-kernel.example
# Soak: node scripts/runtime-kernel-staging-soak.mjs (see docs/RUNTIME_KERNEL_STAGING_SOAK.md)

# Dashboard: VITE_ENABLE_UNIFIED_CLAIM=true (POST /api/stores/claim single endpoint)

# Intelligence Foundation — copy to .env and add your actual API key (server-side only)
OPENAI_API_KEY=your_key_here
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# Gate LLM expression layer on the server (independent of dashboard VITE_PIL_CONCIERGE_LLM)
INTELLIGENCE_LLM_EXPRESSION=true
INTELLIGENCE_EXPRESS_MODEL=gpt-4o-mini

# PIL beta rollout (production controlled)
# CARDEY_BETA_USER_IDS=user-id-1,user-id-2
# CARDEY_BETA_PIL_CANARY_PERCENT=0
# CARDEY_BETA_PIL_OPEN_STAGING=true

# Code fix / self-healing patch proposals (Path A + admin_tool_discovery bridge)
# Default provider is anthropic when unset in codeFixPerformerService.js
ANTHROPIC_API_KEY=\\
CODE_FIX_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
CODE_FIX_MODEL=claude-sonnet-4-6
# LLM_DEFAULT_MODEL must be a valid Anthropic id (no double claude- prefix)
LLM_DEFAULT_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# External capability integration (see docs/EXTERNAL_CAPABILITY_INTEGRATION_READINESS.md)
# Status probe: GET /api/status/features
# ---------------------------------------------------------------------------

# Video generation — video_generate_multimodal
# Provider: mock | openai | kling (auto-detects Kling when KLING_* keys set)
VIDEO_GENERATION_PROVIDER=
VIDEO_ARTIFACT_MOCK_URL=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# C-Net network integration
CNET_API_KEY=
CNET_ENDPOINT=

# Additional LLM providers (AGENT_LLM_PROVIDER, language agent, task planner)
XAI_API_KEY=
GROQ_API_KEY=
GOOGLE_GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Platform connection dashboard — OAuth app credentials (server-side)
# User API keys (OpenAI, Anthropic, etc.) can also be saved per-user via Settings → Integrations
TWITTER_API_KEY=
TWITTER_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
MASTODON_INSTANCE=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Translation — DEEPL preferred when set; otherwise LLM-backed (language agent)
DEEPL_API_KEY=

# Media search — stock photos/videos (PexelsAdapter, VideoSearchService, seed library)
PEXELS_API_KEY=

# Universal Library (catalogue API + population). Non-prod defaults ON when unset.
# ENABLE_UNIVERSAL_LIBRARY_V1=true
# ENABLE_CONTENT_POPULATION_V1=true
# ENABLE_UNIVERSAL_DISCOVERY_V1=true
# ENABLE_REAL_LIBRARY_POPULATION_V1=true
# ENABLE_REAL_LIBRARY_EXPANSION_V1=true
# ENABLE_CARDBEY_ORIGINALS_SOURCE_V1=true
# ENABLE_REAL_LIBRARY_COLLECTIONS_V1=true
# ENABLE_FIRST_EXTERNAL_PROVIDER_V1=true   # required for Pexels/Openverse/Wikimedia UL sync without --force
# ENABLE_EXTERNAL_OPEN_PROVIDER_V1=true    # alias gate for open-media Federation intake
# ENABLE_UNIVERSAL_LIBRARY_FIXTURES_V1=false  # keep OFF on staging/public
# ENABLE_PROVIDER_SCHEDULED_SYNC_V1=false     # keep OFF for this milestone
# Staging bootstrap: node scripts/staging-ul-bootstrap.mjs --provider=pexels --limit=24 --video-reserve=6
#
# URI — rights-aware reuse for Library “Use this” (non-prod defaults ON when unset)
# ENABLE_UNIVERSAL_RESOURCE_INTELLIGENCE_V1=true
# ENABLE_URI_REUSE_PILOT_V1=true
# ENABLE_URI_PROVIDER_SDK_V1=true
# ENABLE_URI_FEDERATION_V1=true
# ENABLE_URI_WORKSPACE_V1=true
# ENABLE_URI_PRODUCT_INTEGRATION_V1=true
# ENABLE_URI_ADAPTER_OPENVERSE=true
# ENABLE_URI_ADAPTER_WIKIMEDIA=true
# ENABLE_URI_ADAPTER_PIXABAY=true   # adapter registered; UL sync deferred in Federation V1
# ENABLE_URI_ADAPTER_UNSPLASH=true  # adapter registered; UL sync deferred in Federation V1
# Wikimedia Commons policy: set a descriptive User-Agent (contact URL or email)
# WIKIMEDIA_USER_AGENT=CardbeyURI/1.0 (https://cardbey.com; ops@example.com)
# WIKIMEDIA_CONTACT=ops@example.com
# Optional: node scripts/ensure-uri-reuse-tables.mjs
#
# Federation V1 credentials (names only — never commit secrets):
#   Pexels:     PEXELS_API_KEY (required)
#   Openverse:  none (public API; rate-limited)
#   Wikimedia:  none (User-Agent required via WIKIMEDIA_USER_AGENT / WIKIMEDIA_CONTACT)

# Store creation research — Google Places API (New) + legacy fallback
# Enable "Places API (New)" in Google Cloud Console (legacy Places API is no longer required)
# https://developers.google.com/maps/documentation/places/web-service/get-api-key
GOOGLE_PLACES_API_KEY=

# Storage — local (default) or S3-compatible (Cloudflare R2, AWS S3)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=
CDN_BASE_URL=

# Tool dispatcher — opt-in retry for transient failures (comma-separated tool names)
# TOOL_DISPATCH_RETRY_TOOLS=video_generate_multimodal,extract_card_data
# TOOL_DISPATCH_RETRY_MAX=2
# TOOL_DISPATCH_RETRY_DELAY_MS=500

# OCR fallback (Agent Chat only; see docs/OCR_FALLBACK.md)
# When primary (OpenAI Vision) returns refusal/invalid, fallback runs if enabled
# GOOGLE_CLOUD_VISION_ENABLED=false
# GOOGLE_CLOUD_VISION_API_KEY=

# Screen status worker (ping the player device)
SCREENS_PING_PATH=/health
SCREENS_DEFAULT_PORT=5174
SCREENS_TIMEOUT_MS=3000
SCREENS_LOG_EVERY=20
SCREENS_SELF_PING=0

# SAM-3 Configuration (optional - see docs/SAM3_SETUP.md)
SAM3_MODEL_PATH=./models/sam3_hiera_large.pt
SAM3_DEVICE=cuda
# or cpu for development machines

# Email verification (optional – when false or MAIL_HOST unset, verification emails are log-only)
ENABLE_EMAIL_VERIFICATION=false
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM_EMAIL=no-reply@cardbey.com
MAIL_FROM_NAME=Cardbey

# Agent chat: when true, user messages that match actionable intent (create, plan, fix, etc.) trigger planner/research.
# When false (default), only explicit Continue/Execute or approval flows dispatch agents; chat is chat-only.
# AUTO_DISPATCH_ON_CHAT=false

# Performer: pre-intake chat agent loop (thought → read-only tools → handoff to Intake V2 classifier). Default off.
# PERFORMER_CHAT_AGENT_LOOP=false
# PERFORMER_AGENT_LOOP_MAX_STEPS=5
# PERFORMER_AGENT_LOOP_MODEL=
# PERFORMER_AGENT_LOOP_PROVIDER=
# Optional: comma-separated subset of tool names (default: market_research,analyze_store,orders_report,generate_social_posts,smart_visual,signage.list-devices)
# PERFORMER_AGENT_LOOP_TOOLS=market_research,orders_report,smart_visual

# Phase 2.3-A — Agent Governance + CoordinationGraph read-only APIs (Blackboard-only). Default OFF.
# When enabled, exposes /api/broker/coordination-graph/* and related governance endpoints.
PERFORMER_AGENT_GOVERNANCE=false

# Phase 2.3-B — Orchestration stability (pressure metrics, batching, presence debounce). Default OFF.
# PERFORMER_ORCHESTRATION_STABILITY: exposes /api/broker/orchestration-stability metrics,
#   enables safeMissionUpdate() light retry/backoff on transient SQLite contention (non-critical
#   metadata writes only), and powers the device-presence contention guard. When OFF, behavior is
#   identical to a plain prisma.mission.update (no retries).
# PERFORMER_DEVICE_PRESENCE_DEBOUNCE: when ON, playlist/full NEVER writes lastSeenAt inline;
#   presence is debounced + flushed asynchronously, best-effort, and skipped under SQLite pressure /
#   active orchestration so device polling can never block mission runtime. Also enables heartbeat
#   async persistence (see PERFORMER_DEVICE_HEARTBEAT_DEBOUNCE).
# PERFORMER_DEVICE_HEARTBEAT_DEBOUNCE: when ON (or when PRESENCE_DEBOUNCE is ON), POST /api/device/heartbeat
#   does not await prisma.device.update on the request path — in-memory presence + async coalesced flush.
# PERFORMER_ORCHESTRATION_STABILITY also enables short-window coalescing of mission access
#   resolution (resolveAccessibleMission) to absorb the post-create_store read burst.
# PERFORMER_MISSION_ACCESS_COALESCE_MS: TTL for that coalescing cache (default 1500; 0 disables).
# PERFORMER_PIPELINE_WRITE_HARDENING: critical MissionPipeline / MissionPipelineStep write hardening.
#   Default OFF. Gates BEHAVIOR ONLY (future: idempotent step insert, critical-mode update retry,
#   atomic create txn). Pipeline write retry/timeout METRICS (pipelineUpdateRetries/Timeouts) are
#   observational and always recorded. NOTE: @@unique([missionId, orderIndex]) on MissionPipelineStep
#   is a schema-level guard applied independently of this flag (after a clean duplicate audit) and
#   makes duplicate step rows structurally impossible.
# PERFORMER_ORCHESTRATION_STABILITY=false
# PERFORMER_BLACKBOARD_BATCHING=false
# PERFORMER_DEVICE_PRESENCE_DEBOUNCE=false
# PERFORMER_DEVICE_HEARTBEAT_DEBOUNCE=false
# PERFORMER_DEVICE_PRESENCE_MIN_INTERVAL_MS=30000
# PERFORMER_MISSION_ACCESS_COALESCE_MS=1500
# PERFORMER_PIPELINE_WRITE_HARDENING=false

# Device Engine Write Isolation (umbrella). Default OFF.
# When ON: device identity writes retry (never skipped); presence/metadata/log writes are coalesced,
# best-effort, and skipped under SQLite contention so they never compete with mission/store runtime.
# When OFF: legacy behavior (still honors the device debounce flags above).
# PERFORMER_DEVICE_WRITE_ISOLATION=false

# Mission Pipeline Write Isolation (umbrella). Default OFF.
# When ON: critical pipeline/FSM writes retry (never skipped); observability/metadata writes are
# coalesced, debounced, or skipped under SQLite pressure. Does not add competing writers for
# status/runState/progress/checkpoint/blackboard seq.
# PERFORMER_MISSION_PIPELINE_WRITE_ISOLATION=false

# SQLite runtime authority write serialization (Phase 2.3-F).
# Local SQLite dev auto-enables this in loadEnv.js unless explicitly set.
# FIFO lane concurrency=1 for critical authority writes (DraftStore.create, mission updates, blackboard).
# Rollback: PERFORMER_SQLITE_RUNTIME_WRITE_SERIALIZATION=false
# PERFORMER_SQLITE_RUNTIME_WRITE_SERIALIZATION=true
# SQLITE_AUTHORITY_WRITE_MAX_QUEUE=500
# SQLITE_AUTHORITY_WRITE_MAX_WAIT_MS=120000

# Mission create burst hardening (Phase 2.3-F2). Default OFF.
# SQLite-only. Wraps createMissionPipeline / createMissionCreationBundle through the 2.3-F lane.
# Use with PERFORMER_SQLITE_RUNTIME_WRITE_SERIALIZATION=true for queueing.
# PERFORMER_MISSION_CREATE_BURST_HARDENING=false

# Phase 2.3-C — Stream-first runtime observability (read-only). Default OFF.
# PERFORMER_STREAM_FIRST_RUNTIME: enable RuntimeSnapshot read model + blackboard stream hook
#   and the /api/broker/runtime-observability + /api/broker/runtime-snapshot/:missionId endpoints.
# PERFORMER_RUNTIME_SNAPSHOT_CACHE: in-memory mission snapshot cache + bounded reconnect replay buffer.
# PERFORMER_ADAPTIVE_POLLING: emit pollingMode guidance (STREAM_PRIMARY / POLL_FALLBACK / RECOVERY_MODE).
# PERFORMER_STREAM_FIRST_RUNTIME=false
# PERFORMER_RUNTIME_SNAPSHOT_CACHE=false
# PERFORMER_ADAPTIVE_POLLING=false

# Content ingest dataset capture (dev-gated; OFF unless ENABLE_CONTENT_INGEST_LOGS=true)
# ENABLE_CONTENT_INGEST_LOGS=false
# CONTENT_INGEST_RETENTION_DAYS=14
# CONTENT_INGEST_MAX_ROWS_PER_DAY=200
# CONTENT_INGEST_SAMPLE_RATE=1.0
# CONTENT_INGEST_WIPE_WEBSITE_URL=false
# CONTENT_INGEST_EXPORT_MAX_LIMIT=500

# Phase 2 � LLM Task Planning
# Set true to run planTaskGraphForIntent for launch_campaign before intake JSON planner / lightweight fallback.
USE_LLM_TASK_PLANNER=false
# OpenClaw: ENABLE_OPENCLAW_AGENT_RUNTIME gates spawnChildAgent / runOpenClawMission (see apps/core/openclaw/config.ts).
ENABLE_OPENCLAW_AGENT_RUNTIME=false
# When true, agentOrchestrator may route agentHint openclaw steps through childAgentBridge (requires runtime enabled above).
OPENCLAW_MISSION_STEPS=false
LLM_TASK_PLANNED_MISSION_TYPES=launch_campaign

# Content Library (SVGRepo + Brandfetch logo search)
BRANDFETCH_API_KEY=your_brandfetch_api_key_here
SVGREPO_API_KEY=optional_if_needed

# Logo search — Logo.dev (registry key "clearbit" in LogoSearchService)
LOGODEV_API_KEY=

# Logo generation (LogoGenerationService — POST /api/media/logo/generate)
RECRAFT_API_KEY=
IDEOGRAM_API_KEY=

# Multi-source video search (VideoSearchService — GET /api/media/video/search)
# Pexels reuses PEXELS_API_KEY. Sources with a blank key are skipped silently.
# Mixkit needs no key (static curated catalogue).
PIXABAY_API_KEY=
# Pixabay Music (Creative Factory / playlists) — requires PIXABAY_API_KEY
ENABLE_PIXABAY_MUSIC=false
COVERR_API_TOKEN=

# Slideshow generation (generate_slideshow — mock for local dev)
# SLIDESHOW_GENERATION_PROVIDER=mock
# SLIDESHOW_ARTIFACT_MOCK_URL=https://www.w3schools.com/html/mov_bbb.mp4

# LangChain.js executor (RAG via runRagForMission + step memory); orchestrator routes agentHint "langchain".
LANGCHAIN_ENABLED=false

# Agent execution LLM (used by agentRegistry callAsAgent; market_research -> researcher)
AGENT_LLM_PROVIDER=xai
AGENT_LLM_MODEL=grok-3-beta

# ---------------------------------------------------------------------------
# Agent Execution Broker + Performer Runtime (staging authority consolidation)
# See docs/BROKER_TELEMETRY_COVERAGE_REPORT.md and docs/RUNTIME_OWNERSHIP_GAP_MAP.md
# Rollout order: A → B → C → D → E (enable one stage at a time in staging)
# ---------------------------------------------------------------------------

# --- Stage E stable (Single Runway enforceable) ---
# With EXECUTION_MODE=kernel these are the effective defaults (legacy flags kept for reference only).
# Recommended staging defaults once A–E are validated.
# Keep orchestra bypass block OFF until explicitly validated.
BROKER_EXECUTION_TELEMETRY=true
BROKER_TELEMETRY_REQUIRED=false
BROKER_DIRECT_VIA_FACADE=true
BROKER_BLOCK_DIRECT_ACTION=true
BROKER_BLOCK_ORCHESTRA_WITH_MISSION=false
PERFORMER_RUNTIME_ENABLED=true
PERFORMER_RUNTIME_PIPELINE_FACADE=true
PERFORMER_RUNTIME_OWNERSHIP_WARN=true
PERFORMER_RUNTIME_OWNERSHIP_BLOCK=true
PERFORMER_RUNTIME_UNIFIED_STREAM=true
PERFORMER_RUNTIME_STATE_PERSIST=true
PERFORMER_EXECUTION_RECORDS_PERSIST=true
PERFORMER_RUNTIME_DUPLICATION_DETECT=true

# Phase 2.0 — advisory routing (read-only; default OFF)
PERFORMER_ADVISORY_ROUTING=false
# Phase 2.2 — CapabilityGraph read model APIs (default OFF)
PERFORMER_CAPABILITY_GRAPH=false
# Mission-scoped IntentGraph writer (metadataJson snapshot; default ON)
PHASE2_INTENT_GRAPH_MISSION_SCOPE=true
# Phase 2.3+ only — MUST remain false in Phase 2.0 (hardcoded OFF in code)
# BROKER_DYNAMIC_ROUTING_EXECUTE=false

# --- Broker telemetry (Phase 1) ---
# Record broker.execution probes on dispatch_tool / executeMissionAction paths. Default: true
# BROKER_EXECUTION_TELEMETRY=true
# Dev/test: throw if telemetry hook skipped. Default: false
# BROKER_TELEMETRY_REQUIRED=false

# Stage A: Route Performer intake direct_action through executeMissionAction (not dispatchTool directly)
# BROKER_DIRECT_VIA_FACADE=false

# Stage D: Reject Performer direct_action tool dispatch (use IntentRequest / mission pipeline)
# BROKER_BLOCK_DIRECT_ACTION=false

# Block POST /api/mi/orchestra/start when body includes missionId (mission bypass)
# BROKER_BLOCK_ORCHESTRA_WITH_MISSION=false

# --- Performer Runtime kernel (Phase 1.5) ---
# Stage B: Route intake V2 direct tools through performerRuntime.execute()
# PERFORMER_RUNTIME_ENABLED=false

# Stage C: Route mission pipeline steps through executeRuntimeAction facade
# PERFORMER_RUNTIME_PIPELINE_FACADE=false

# Emit runtime.* events to blackboard + SSE (event source model). Default: true
# PERFORMER_RUNTIME_UNIFIED_STREAM=true

# Warn on dispatch outside runtime ownership (broker.runtime.violation). Default: true
# PERFORMER_RUNTIME_OWNERSHIP_WARN=true

# Stage E: Block dispatch when runtime ownership missing. Default: false
# PERFORMER_RUNTIME_OWNERSHIP_BLOCK=false

# Persist runtime snapshot on Mission.context.performerRuntime. Default: true
# PERFORMER_RUNTIME_STATE_PERSIST=true

# Persist canonical execution records (Mission.context.performerExecutionRecords). Default: true
# PERFORMER_EXECUTION_RECORDS_PERSIST=true

# Detect duplicate mission+tool dispatch within 15s (broker.runtime.duplication). Default: true
# PERFORMER_RUNTIME_DUPLICATION_DETECT=true

# Staging diagnostics: GET /api/broker/runtime-authority (in-process metrics + flag snapshot)

# ---------------------------------------------------------------------------
# Phase F — Legacy bypass closure (default: telemetry ON, blocks OFF)
# See docs/IMPACT_REPORT_PHASE_F_LEGACY_BYPASS.md
# ---------------------------------------------------------------------------
# PHASE_F_BYPASS_TELEMETRY=true
# PHASE_F_BLOCK_MCP_DIRECT_DISPATCH=false
# PHASE_F_ROUTE_MCP_VIA_FACADE=false
# PHASE_F_BLOCK_PROACTIVE_STEP_LEGACY=false
# PHASE_F_BLOCK_DRAFT_STORE_RUNWAY=false
# Dashboard: VITE_PHASE_F_VIEWER_ONLY_CAPABILITY_PLAN=false
# GET /api/broker/phase-f-bypass — in-process Phase F metrics

# ---------------------------------------------------------------------------
# Phase 1 — MissionEvidenceGraph as write target (loyalty; staging rollout)
# Rollback: PHASE1_GRAPH_PRIMARY=false (dual-write), then GRAPH_WRITE_TARGET=false
# Staging template: .env.staging.runtime-kernel.example + render.yaml cardbey-core-staging
# Dashboard: VITE_PHASE1_PROJECTION_FROM_GRAPH=true (.env.staging)
# ---------------------------------------------------------------------------
# PHASE1_GRAPH_WRITE_TARGET=true
# PHASE1_GRAPH_PRIMARY=false
# PHASE1_GRAPH_CONFLICT_DETECTION=true
# PHASE1_CONSOLIDATED_REASONING_TRACE=true
# PHASE1_PROJECTION_FROM_GRAPH=true

# ---------------------------------------------------------------------------
# Phase 2 — Active reasoning loop (ReasoningCoordinator)
# Default OFF — enable in staging after Phase 1 soak passes.
# Rollback: PHASE2_ACTIVE_REASONING=false
# ---------------------------------------------------------------------------
# PHASE2_ACTIVE_REASONING=false
# PHASE2_TOPOLOGY_AS_SNAPSHOT=true
# PHASE2_REASONING_STEP_LOG=false
# PHASE2_REASONING_STAGING_ONLY=true
# PHASE2_REASONING_ROLLOUT_PERCENT=25
# PHASE2_REASONING_TELEMETRY=true
# GET /api/broker/phase2-reasoning?missionId=...

# ---------------------------------------------------------------------------
# P6 — Reliability Layer (auto-heal, rate limits, bulkhead, SLO, alerts)
# ---------------------------------------------------------------------------
# AUTO_HEAL_INTERVAL_MS=30000
# SLO_EVAL_INTERVAL_MS=60000
# RELIABILITY_AUTO_HEAL=true
# RELIABILITY_SLO_LOOP=true
# Optional webhook URL for alerts (Slack, PagerDuty, etc.)
# Local dev test inbox (Core must be running on port 3001):
# RELIABILITY_WEBHOOK_URL=http://localhost:3001/api/reliability/webhook/inbox
# Example Slack: https://hooks.slack.com/services/xxx/yyy/zzz
RELIABILITY_WEBHOOK_URL=

# Maintenance endpoint guard policy
# Required: without this, POST /maintenance is completely disabled
PERFORMER_MAINTENANCE_SECRET=

# Optional: comma-separated IPs allowed to call POST /maintenance
# Leave empty to skip IP check
PERFORMER_MAINTENANCE_IP_ALLOWLIST=

# ---------------------------------------------------------------------------
# System Observation (Control Center architecture catalog)
# ---------------------------------------------------------------------------
# Enable live component status API for platform admins
ENABLE_SYSTEM_OBSERVATION=true
# Cache TTL for observation probes (ms)
SYSTEM_OBSERVATION_CACHE_MS=30000
# Dashboard heartbeat stale threshold (ms)
SYSTEM_OBSERVATION_HEARTBEAT_STALE_MS=300000

# ---------------------------------------------------------------------------
# Stripe (customer journey payments — test mode keys from dashboard.stripe.com)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Multi-Agent DeepSeek Integration (Cardbey Performer)
# See src/multiAgent/README.md and docs/multiAgent/
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ENABLED=true
DEEPSEEK_THINKING_MODE=enabled
DEEPSEEK_REASONING_EFFORT=medium
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TIMEOUT=60000
DEEPSEEK_RETRY_ATTEMPTS=3
DEEPSEEK_AB_TRAFFIC_PERCENT=100

AGENT_INTENT_CLASSIFIER_MODEL=deepseek-v4-flash
AGENT_INTENT_CLASSIFIER_PROVIDER=deepseek
AGENT_TOPOLOGY_SELECTOR_MODEL=deepseek-v4-flash
AGENT_TOPOLOGY_SELECTOR_PROVIDER=deepseek
AGENT_SPECIALIST_MODEL=deepseek-v4-flash
AGENT_SPECIALIST_PROVIDER=deepseek
AGENT_PLANNER_MODEL=deepseek-v4-flash
AGENT_PLANNER_PROVIDER=deepseek
AGENT_CRITIC_MODEL=deepseek-v4-flash
AGENT_CRITIC_PROVIDER=deepseek
AGENT_REFINER_MODEL=deepseek-v4-flash
AGENT_REFINER_PROVIDER=deepseek
AGENT_REASONING_MODEL=deepseek-v4-flash
AGENT_REASONING_PROVIDER=deepseek

MULTI_AGENT_ENABLED=true
MULTI_AGENT_PARALLEL_LIMIT=5
MULTI_AGENT_RETRY_ON_FAILURE=true
MULTI_AGENT_MAX_REFINEMENTS=3
MULTI_AGENT_EXECUTE=false
MULTI_AGENT_SHADOW=true
# Phase 2: multiAgent LLM via llmGateway (default provider deepseek; swap with kimi|anthropic|openai|groq)
MULTIAGENT_PROVIDER=deepseek
MULTIAGENT_FALLBACK_PROVIDER=anthropic
# MULTIAGENT_USE_GATEWAY=false
# INTENT_PROVIDER=deepseek
# INTENT_USE_REGEX=true
# Require explicit user confirmation before multi_agent / campaign_orchestration AUTO_RUN (PIL governance)
MULTI_AGENT_REQUIRE_CONFIRMATION=true
# Comma-separated internal user IDs allowed to use skipConfirmation=true
# MULTI_AGENT_SKIP_CONFIRMATION_USERS=
# MULTI_AGENT_GOVERNANCE_LOG=true
AGENT_TRACE_ENABLED=true
AGENT_TELEMETRY_ENABLED=true
AGENT_LOG_LEVEL=info
AGENT_SHADOW_LOG_DETAILED=true
HITL_REVIEW_ENABLED=true

# Multi-agent monitoring (Control Center dashboard + alerts)
MONITORING_ENABLED=true
METRICS_RETENTION_DAYS=30
METRICS_FLUSH_INTERVAL=60000
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#cardbey-alerts
ALERT_EMAIL_RECIPIENTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
PAGERDUTY_INTEGRATION_KEY=
PAGERDUTY_SERVICE_ID=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
ALERT_SUCCESS_RATE_WARNING=0.85
ALERT_SUCCESS_RATE_CRITICAL=0.70
ALERT_ERROR_RATE_WARNING=0.05
ALERT_ERROR_RATE_CRITICAL=0.10
ALERT_RESPONSE_TIME_WARNING=5000
ALERT_RESPONSE_TIME_CRITICAL=10000
ALERT_COST_PER_MISSION_WARNING=0.20
ALERT_HITL_RATE_WARNING=0.15
ALERT_SHADOW_ACCURACY_WARNING=0.80

OPENAI_BACKUP_MODEL=gpt-4o-mini
ANTHROPIC_BACKUP_MODEL=claude-sonnet-4-2
XAI_BACKUP_MODEL=grok-3-beta
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY_DEFAULT=AUD

# Self-Audit Configuration
SELF_AUDIT_ENABLED=true
SELF_AUDIT_SCHEDULE="0 */6 * * *"
SELF_AUDIT_AUTO_FIX=false
SELF_AUDIT_MAX_ISSUES=100
SELF_AUDIT_RETENTION_DAYS=30

# Telemetry Integration (self-audit)
TELEMETRY_SYNC_ENABLED=true
TELEMETRY_SYNC_INTERVAL=300

# Alert Channels (self-audit)
SELF_AUDIT_SLACK_WEBHOOK=${SLACK_WEBHOOK_URL}
SELF_AUDIT_EMAIL_RECIPIENTS=${ALERT_EMAIL_RECIPIENTS}

# --- Cardbey Live Market / Global Live (all default OFF) ---
# ENABLE_LIVE_MARKET_V1=false
# ENABLE_LIVE_MARKET_OWNER_V1=false
# ENABLE_LIVE_MARKET_ADMIN_V1=false
# ENABLE_LIVE_MARKET_PUBLIC_V1=false
# ENABLE_LIVE_MARKET_STOREFRONT_PUBLISH_V1=false
# ENABLE_LIVE_MARKET_STOREFRONT_CONSUME_V1=false
# ENABLE_LIVE_MARKET_GLOBAL_FEED_V1=false
# ENABLE_LIVE_MARKET_REGISTRATION_V1=false
