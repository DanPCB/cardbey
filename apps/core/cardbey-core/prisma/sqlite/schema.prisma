  views            Int       @default(0)
  likes            Int       @default(0)
  shares           Int       @default(0)
  bookmarks        Int       @default(0)
  runtimeMissionId String?
  sourceType       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  classifications CreatorClassification[]
