model AccountingDocument {
  id                 String    @id @default(cuid())
  storeId            String
  type               String
  status             String
  documentNumber     String?
  currency           String    @default("AUD")
  gstMode            String    @default("GST_EXCLUSIVE")
  issueDate          DateTime?
  expiryDate         DateTime?
  dueDate            DateTime?
  issuedAt           DateTime?
  paidAt             DateTime?
  acceptedAt         DateTime?
  acceptedBy         String?
  acceptedByUserId   String?
  purchaseOrderRef   String?
  notes              String?
  terms              String?
  buyerJson          Json?
  issuedSnapshot     Json?
  sourceQuoteId      String?
  convertedInvoiceId String?
  quoteRequestId     String?
  subtotalCents      Int       @default(0)
  gstCents           Int       @default(0)
