// Cardbey Core API - Prisma Schema (SQLite)
// Used for: local dev, unit tests. Migrations: prisma/sqlite/migrations (migrate deploy/dev).
// Legacy DBs missing hero columns: node scripts/ensure-business-hero-columns.mjs
// Legacy DBs missing Product.itemType: node scripts/ensure-product-catalog-columns.mjs
// Generate: npx prisma generate --schema prisma/sqlite/schema.prisma
// App must import from this output (client-gen); do not use @prisma/client default or WorkflowRun will be missing.
//
// DATABASE_URL (SQLite): use file:../dev.db or file:../test.db so Prisma resolves from this
// folder (prisma/sqlite/) to prisma/dev.db — same path src/env/ensureDatabaseUrl.js uses for the server.

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client-gen"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User with business and onboarding tracking
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  displayName         String?
  fullName            String? // Full name for public profile
  handle              String?   @unique // Public profile handle/slug (e.g., "john-doe")
  avatarUrl           String? // URL to user avatar image
  accountType         String? // "personal" | "business" | "both"
  tagline             String? // Optional tagline/bio for public profile
  hasBusiness         Boolean   @default(false)
  onboarding          String? // JSON string: {"completed":false,"currentStep":"welcome"}
  roles               String    @default("[\"viewer\"]") // JSON array string: ["viewer","admin"]
  role                String    @default("owner") // "owner" | "staff" | "viewer" | "admin" | "super_admin" (platform roles)
  emailVerified       Boolean   @default(false) // Phase 2: Email verification status
  verificationToken   String? // Phase 2: Hashed one-time verification token
  verificationTokenRaw String? // Raw token for resend only; cleared on confirm. Not exposed in API.
  verificationExpires DateTime? // Phase 2: Token expiration time
  resetToken          String? // Phase 2: Password reset token
  resetExpires        DateTime? // Phase 2: Reset token expiration time
  aiCreditsBalance    Int       @default(0) // Paid AI credits (consumed when not using welcome bundle)
  welcomeFullStoreRemaining Int  @default(1) // One full AI store generation free per user (idempotent grant on register)
  aiCreditsUpdatedAt  DateTime? // Last time credits were changed (optional)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Personal profile (Phase 1; all nullable; displayName already exists above)
  profilePhoto                    String?
  bio                             String?
  qrCodeUrl                       String?
  personalPresenceStoreId         String?   @unique
  personalPresenceStore           Business? @relation("PersonalPresenceStore", fields: [personalPresenceStoreId], references: [id], onDelete: SetNull)

  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  country        String?
  postcode       String?
  socialLinks    Json? // { instagram?, facebook?, tiktok?, x?, youtube?, linkedin?, whatsapp? }

  // Relations (one user can have multiple stores)
  businesses          Business[]
  personalMedia       PersonalMedia[]
  demands             Demand[]
  contents            Content[]
  greetingCards       GreetingCard[]
  passwordResetTokens PasswordResetToken[]
  draftStoresOwned    DraftStore[] @relation("DraftStoreOwner")
  createdChatThreads  ChatThread[] @relation("ChatThreadCreator")
  createdConversationThreads ConversationThread[] @relation("ConversationThreadCreator")
  createdMissions            Mission[]           @relation("MissionCreator")
  userIdentifiers            UserIdentifier[]
  smartDocuments             SmartDocument[]
  cards                      Card[]
  creator                    Creator?
  creatorPayoutAccount       CreatorPayoutAccount?
  accountProfile             AccountProfile?
  userAccountEvents          UserAccountEvent[] @relation("UserAccountEventSubject")
  suitcaseItems              SuitcaseItem[]
  conversationSessions       ConversationSession[]
  liveMarketParticipantRegistrations LiveMarketParticipantRegistration[]
  connectionsFrom            UserConnection[] @relation("ConnectionFrom")
  connectionsTo              UserConnection[] @relation("ConnectionTo")

  @@index([email])
  @@index([handle])
  @@index([verificationToken])
  @@index([resetToken])
}

model AccountProfile {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  capabilities                Json     @default("[]")
  primaryCapability           String?
  accountStatus               String   @default("ACTIVE")
  creatorPublishingRestricted Boolean  @default(false)
  businessManagementRestricted Boolean @default(false)
  internalNotes               Json?
  languages                   Json?
  lastActiveAt                DateTime?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([accountStatus])
}

model UserAccountEvent {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation("UserAccountEventSubject", fields: [userId], references: [id], onDelete: Cascade)
  eventType         String
  actorUserId       String?
  actorRole         String?
  reasonCode        String?
  publicReason      String?
  internalNote      String?
  previousStateJson Json?
  nextStateJson     Json?
  requestId         String?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

model TelemetryProbe {
  id        String   @id @default(cuid())
  tag       String
  status    String
  missionId String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([tag])
  @@index([createdAt])
  @@index([missionId])
}

/// Hero video upload / verify / playback client telemetry (dashboard → POST /api/telemetry/hero-video).
model TelemetryHeroVideo {
  id            String    @id @default(cuid())
  eventType     String
  url           String?
  storageKey    String?
  attemptNumber Int?
  httpStatus    Int?
  durationMs    Int?
  errorCode     Int?
  environment   String?
  userId        String?
  clientTs      DateTime?
  createdAt     DateTime  @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@index([storageKey])
  @@index([environment])
}

/// Dashboard navigation / admin tool discovery telemetry.
model TelemetryNavigation {
  id           String    @id @default(cuid())
  eventType    String
  userId       String?
  userRole     String?
  sessionId    String?
  fromPath     String?
  toPath       String?
  targetSection String?
  searchQuery  String?
  timeOnPageMs Int?
  environment  String?
  metadata     Json?
  clientTs     DateTime?
  createdAt    DateTime  @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@index([userId])
  @@index([sessionId])
  @@index([userRole])
}

/// Create-store understanding audit (Phase 4 CanonicalUnderstanding observability).
model PerformerAuditLog {
  id                String   @id @default(cuid())
  sessionId         String
  userId            String?
  step              String
  imageHash         String
  understandingId   String?
  source            String?
  confidence        Float?
  fields            Json?
  validationResult  Json?
  userAction        String?
  userEdits         Json?
  error             String?
  metadata          Json?
  environment       String?
  createdAt         DateTime @default(now())

  @@index([imageHash])
  @@index([createdAt])
  @@index([sessionId])
  @@index([step, source])
  @@index([confidence])
  @@index([userId, createdAt])
}

model PersonalMedia {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  type      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Business/Store entity
// Translation support: The original fields (name, description) are the authoritative source language content.
// The translations JSON field stores AI-generated or manually edited translations, keyed by language code.
// Example structure: { "en": { "name": "...", "description": "..." }, "vi": { "name": "...", "description": "..." } }
model Business {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         String
  slug         String   @unique
  description  String?
  showOwnerProfile  Boolean  @default(false)
  translations Json? // Translations keyed by language code: { "en": { "name": "...", "description": "..." }, "vi": { ... } }
  logo         String? // JSON string: {"url":"https://..."}
  region       String?
  isActive     Boolean  @default(true)
  tradingHours Json? // JSON object for trading hours
  address      String?
  addressLine2 String?
  suburb       String?
  city         String?
  state        String?
  postcode     String?
  country      String?
  formattedAddress String?
  locationSource String?
  locationConfidence String?
  osmPlaceId   String?
  phone        String?
  email        String?
  websiteUrl   String?
  mapUrl       String?
  lat          Float?
  lng          Float?
  // Brand fields for business creation and template binding
  primaryColor    String? // Primary brand color (hex code)
  secondaryColor  String? // Secondary brand color (hex code)
  tagline         String? // Business tagline/slogan
  heroText        String? // Hero text for marketing materials
  heroImageUrl    String? // Storefront hero image URL (from draft publish)
  avatarImageUrl  String? // Store avatar/logo image URL (from draft publish)
  publishedAt     DateTime? // When the store was last published (from draft)
  transactionMode String   @default("order") // "booking" | "order"
  catalogLabel    String   @default("Products")
  ctaLabel        String   @default("Order now")
  stylePreferences Json? // Style preferences: { style: "modern", mood: "warm", etc. }
  storefrontSettings Json? // { catalogDisplayPreference: "auto"|"list"|"grid", defaultView: "list"|"grid", allowUserToggle: boolean }
  socialLinks      Json? // { instagram?, facebook?, tiktok?, x?, youtube?, linkedin?, whatsapp? }
  brandTone        String? // e.g. luxury, friendly, minimal, bold
  brandStyle       String? // e.g. modern, vintage, playful
  brandColors      String? // JSON array string e.g. '["pink","gold"]'
  provenance       String?  @default("owner")
  claimStatus      String?
  /// Ingestion seed that produced this store (Phase 6 uniqueness / claim race guard)
  seedId           String?
  captureCount     Int      @default(1)
  capturedByUserId String?
  isGuestDraft  Boolean   @default(false)
  expiresAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  products    Product[]
  bookings    Booking[]
  quoteRequests QuoteRequest[]
  productVariants ProductVariant[]
  warehouses  Warehouse[]
  inventoryItems InventoryItem[]
  inventoryMovements InventoryMovement[]
  suppliers   Supplier[]
  purchaseOrders PurchaseOrder[]
  posOrders   PosOrder[]
  payments    Payment[]
  receipts    Receipt[]
  commerceCustomers CommerceCustomer[]
  commerceStaff CommerceStaff[]
  commerceShifts CommerceShift[]
  cashDrawers CashDrawer[]
  commerceTables CommerceTable[]
  reservations Reservation[]
  commercePromotions CommercePromotion[]
  loyaltyAccounts LoyaltyAccount[]
  taxProfiles TaxProfile[]
  commerceBusinessSettings CommerceBusinessSettings?
  businessEvents BusinessEvent[]
  businessBillingProfile BusinessBillingProfile?
  accountingDocuments AccountingDocument[]
  accountingDocumentSequences AccountingDocumentSequence[]
  accountingDocumentShares AccountingDocumentShare[]
  storePromos StorePromo[]
  storeOffers StoreOffer[]
  personalPresenceOwner User? @relation("PersonalPresenceStore")
  smartDocuments SmartDocument[]
  merchantDesigns MerchantDesign[]
  contentLibraryAssets ContentLibraryAsset[]
  publishedArtifactProjection PublishedArtifactProjection?
  storeEngagementSnapshot StoreEngagementSnapshot?
  storeActivityEvents     StoreActivityEvent[]
  storeFollows            StoreFollow[]
  storeReactions          StoreReaction[]
  storeSaves              StoreSave[]
  storeShares             StoreShare[]
  offerClaims             OfferClaim[]
  liveMarketPilotEnrollment LiveMarketPilotEnrollment?
  liveMarketSessions        LiveMarketSession[]
  liveMarketParticipantRegistrations LiveMarketParticipantRegistration[]

  @@index([userId])
  @@index([slug])
  @@index([seedId])
  @@unique([seedId])
}

// DANH: skill-round2-booking — store appointments (Performer + MI + storefront)
model Booking {
  id            String   @id @default(cuid())
  storeId       String
  serviceId     String?
  staffId       String?
  customerId    String?
  customerName  String?
  customerEmail String?
  customerPhone String?
  date          String // ISO date YYYY-MM-DD
  timeSlot      String // HH:MM
  durationMins  Int      @default(30)
  status        String   @default("pending") // pending | confirmed | cancelled | completed
  notes         String?
  price         Float?
  currency      String?  @default("AUD")
  sourceAgent   String? // performer | storefront | mi
  missionId     String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, date])
  @@index([storeId, status])
  @@index([date, timeSlot])
}

model QuoteRequest {
  id              String   @id @default(cuid())
  storeId         String
  serviceId       String?
  customerId      String?
  customerName    String
  customerEmail   String
  customerPhone   String?
  description     String
  address         String?
  preferredDate   String?
  uploadedFiles   Json?
  approximateSize String?
  budget          Float?
  quoteAmount     Float?
  quoteMessage    String?
  status          String   @default("new") // new | reviewing | quoted | accepted | declined | completed
  missionId       String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, createdAt])
}

/// Canonical published store projection (single source for public read surfaces).
model PublishedArtifactProjection {
  id             String   @id @default(cuid())
  artifactType   String   @default("business")
  businessId     String   @unique
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tenantId       String
  storeId        String
  slug           String
  version        String   @default("v1")
  projectionJson Json
  // DANH: fix-hero-video-publish
  heroVideoUrl   String?  // AI-generated or uploaded video hero
  heroMediaType  String?  // 'video' | 'image'
  sourceDraftId  String?
  publishRunId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([slug])
  @@index([tenantId, slug])
}

/// Saved assets from Content Library (SVGRepo / Brandfetch / hosted)
model ContentLibraryAsset {
  id          String   @id @default(cuid())
  storeId     String?
  name        String
  url         String
  sourceUrl   String
  type        String
  format      String
  source      String
  category    String?
  tags        Json?
  license     String?
  metadata    Json?
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  store       Business? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId])
}

/// AI / Contents Studio design snapshots (DesignSpec JSON) per store
model MerchantDesign {
  id       String   @id @default(cuid())
  storeId  String
  store    Business @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name     String?
  specJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

// Phase 1 Scan & Redeem: public promo landing + QR (slug, scan tracking). Used by POST/GET /api/promos, GET/POST /api/public/promos/:slug.
model StorePromo {
  id           String    @id @default(cuid())
  storeId      String
  business     Business  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId    String?
  title        String
  subtitle     String?
  description  String?
  heroImage    String?   // Legacy/fallback for public response
  heroImageUrl String?
  ctaLabel     String?
  targetUrl    String
  code         String?   // Coupon code (API: couponCode)
  startsAt     DateTime?
  endsAt       DateTime?
  slug         String    @unique
  isActive     Boolean   @default(true)
  promoType    String?   @default("general") // DANH: schema-gap-storepromo-type — loyalty / discount / event promos
  scanCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([storeId])
  @@index([slug])
  @@index([isActive])
}

// Product/Catalog Item entity
// Translation support: The original fields (name, description, category) are the authoritative source language content.
// The translations JSON field stores AI-generated or manually edited translations, keyed by language code.
// Example structure: { "en": { "name": "...", "description": "...", "category": "..." }, "vi": { ... } }
model Product {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  normalizedName String? // Normalized name for deduplication
  description   String?
  translations  Json? // Translations keyed by language code: { "en": { "name": "...", "description": "...", "category": "..." }, "vi": { ... } }
  price         Float?
  currency      String?   @default("USD")
  category      String?
  imageUrl      String?
  sku           String? // Stock keeping unit (optional)
  isPublished   Boolean   @default(false) // Only published products are visible publicly
  images        Json? // Array of image URLs
  viewCount     Int       @default(0)
  likeCount     Int       @default(0)
  hasSam3Cutout Boolean   @default(false) // Whether product has SAM-3 generated cutout
  cutoutPath    String? // Path to SAM-3 cutout image (e.g., /public/catalog-cutouts/product-id.png)
  isFeatured    Boolean   @default(false) // DANH: schema-gap-product-featured
  featuredAt    DateTime? // DANH: schema-gap-product-featured
  itemType       String?  // service | product | ticket | event | venue | package
  bookingEnabled Boolean?
  purchaseEnabled Boolean?
  primaryAction  String?  // book | add_to_cart | enquire
  serviceCatalog Json?   // Service catalog metadata: serviceMode, pricingModel, fromPrice, etc.
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  variants      ProductVariant[]
  inventoryItems InventoryItem[]
  posOrderItems PosOrderItem[]

  @@index([businessId])
  @@index([businessId, isPublished])
  @@index([category])
  @@index([deletedAt])
  @@index([hasSam3Cutout])
  @@unique([businessId, normalizedName], name: "unique_business_normalized_name")
}

// User intent/demand tracking
model Demand {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String
  category    String
  intent      String
  context     String? // JSON string: {"page":"/","trigger":"button"}
  fulfilled   Boolean   @default(false)
  fulfilledAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// Journey System - Multi-step playbooks and planner

enum JourneyStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum StepStatus {
  PENDING
  READY
  RUNNING
  DONE
  FAILED
  SKIPPED
}

enum StepKind {
  INFO
  FORM
  ACTION
  REVIEW
}

enum ActionKind {
  NONE
  CREATE_STORE
  OCR_MENU
  DESIGN_FLYER
  PUBLISH_SCREEN
  CREATE_CAMPAIGN
  SEND_EMAIL
  WEBHOOK
}

model JourneyTemplate {
  id        String                @id @default(cuid())
  slug      String                @unique
  title     String
  summary   String?
  category  String? // "store", "marketing", "screens"
  tags      String                @default("[]") // JSON array: ["quick","beginner"]
  createdAt DateTime              @default(now())
  steps     JourneyStepTemplate[]
  instances JourneyInstance[]

  @@index([slug])
  @@index([category])
}

model JourneyStepTemplate {
  id         String          @id @default(cuid())
  orderIndex Int
  title      String
  hint       String?
  kind       StepKind        @default(INFO)
  action     ActionKind      @default(NONE)
  templateId String
  template   JourneyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  paramsJson String? // JSON string: {"fields":[...],"defaults":{...}}
  steps      JourneyStep[]

  @@index([templateId, orderIndex])
}

model JourneyInstance {
  id         String          @id @default(cuid())
  userId     String
  templateId String
  template   JourneyTemplate @relation(fields: [templateId], references: [id])
  status     JourneyStatus   @default(ACTIVE)
  title      String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  steps      JourneyStep[]
  tasks      PlannerTask[]

  @@index([userId])
  @@index([status])
}

model JourneyStep {
  id             String              @id @default(cuid())
  instanceId     String
  instance       JourneyInstance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepTemplateId String
  stepTemplate   JourneyStepTemplate @relation(fields: [stepTemplateId], references: [id])
  orderIndex     Int
  status         StepStatus          @default(PENDING)
  kind           StepKind            @default(INFO)
  action         ActionKind          @default(NONE)
  paramsJson     String? // JSON string: runtime params
  resultJson     String? // JSON string: execution result
  scheduledAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?

  @@index([instanceId, orderIndex])
  @@index([status])
}

model PlannerTask {
  id        String          @id @default(cuid())
  userId    String
  journeyId String
  journey   JourneyInstance @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  stepId    String
  runAt     DateTime
  status    String          @default("queued") // queued|running|done|failed|skipped
  lastError String?
  createdAt DateTime        @default(now())

  @@index([userId])
  @@index([status, runAt])
}

model AssistantSuggestion {
  id         String   @id @default(cuid())
  userId     String
  mode       String // 'home'|'store'|'screens'|'marketing'|'performer'
  templateId String?
  title      String
  reason     String?
  score      Float    @default(0)
  createdAt  DateTime @default(now())

  @@index([userId, mode])
  @@index([score])
}

// ============================================
// AI Orchestration Models
// ============================================

model EventLog {
  id         String   @id @default(cuid())
  kind       String
  zone       String
  payload    String // JSON stringified
  occurredAt DateTime @default(now())
  meta       String? // JSON stringified

  @@index([kind])
  @@index([zone])
  @@index([occurredAt])
}

model SuggestionLog {
  id          String   @id @default(cuid())
  node        String
  title       String
  description String?
  confidence  Float
  impact      String?
  actions     String // JSON stringified
  sourceEvent String?
  createdAt   DateTime @default(now())
  status      String   @default("PENDING") // PENDING|APPLIED|IGNORED

  // Phase 2: Apply tracking
  appliedBy String?
  appliedAt DateTime?

  // Phase 2: Latency tracking
  latencyZoneAMs    Int?
  latencyZoneBMs    Int?
  latencyEndToEndMs Int?

  // Phase 2: Multi-tenancy (future)
  tenantId String?

  @@index([node])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
}

// Phase 2: Idempotency tracking
model IdempotencyKey {
  id        String   @id @default(cuid())
  keyHash   String   @unique
  response  String // JSON cached response
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([keyHash])
  @@index([expiresAt])
}

// Transition audit - doctrine boundary: all status transitions logged
model AuditEvent {
  id            String   @id @default(cuid())
  entityType    String   // "DraftStore" | "OrchestratorTask" | "Business"
  entityId      String
  action        String   // "status_transition" | "publish" | etc
  fromStatus    String?
  toStatus      String?
  actorType     String   // "human" | "automation" | "worker" | "system"
  actorId       String?
  correlationId String?  // generationRunId / traceId / jobId
  reason        String?  // small code e.g. "ORCHESTRA_START", "GENERATE_DRAFT", "EXPIRE", "PUBLISH"
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([correlationId])
}

model ContentEditProposal {
  id                 String    @id @default(cuid())
  actorId            String
  storeId            String
  draftId            String?
  revisionId         String?
  contentType        String // e.g. "shows"
  contentItemId      String
  scopedFieldsJson   String // JSON string[]
  baseFingerprint    String
  baseUpdatedAt      String?
  proposedPatchJson  String // JSON patch object (safe fields only)
  beforeSnapshotJson String // JSON snapshot without private media secrets
  afterSnapshotJson  String
  providerMethod     String // deterministic_relevance | deterministic_a11y | not_configured | …
  status             String // PENDING | ACCEPTED | DISCARDED | EXPIRED | STALE | FAILED
  expiresAt          DateTime
  acceptedAt         DateTime?
  discardedAt        DateTime?
  appliedRevisionId  String?
  adminReason        String?
  correlationId      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([storeId, status, createdAt])
  @@index([actorId, createdAt])
  @@index([contentType, contentItemId, status])
  @@index([expiresAt])
  @@index([correlationId])
}

model DevSystemProposal {
  id                 String   @id @default(cuid())
