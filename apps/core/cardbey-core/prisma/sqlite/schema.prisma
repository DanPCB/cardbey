// Password reset token (hashed); one-time use, short-lived
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    // SHA-256 of raw token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// Draft Store - Temporary store previews before user signup
model DraftStore {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime  // Will be set to now + 48 hours in service
  mode            String    // 'ai' | 'ocr' | 'template' | 'personal'
  status          String    @default("draft") // 'draft' | 'generating' | 'ready' | 'failed' | 'committed' | 'abandoned'
  generationRunId String?   @unique // O(1) lookup for MI job run; also stored in input JSON for backward compatibility
  input           Json      // Stores prompt, businessType, location, templateId, uploaded media references, etc.
  preview         Json?    // Generated preview payload: storeName, slogan, categories, items, assets
  publishSnapshot Json?    // Canonical publish snapshot (preview + publish source of truth when PUBLISH_SNAPSHOT_V1)
  publishSnapshotVersion Int @default(0)
  error           String?   // Store stack/err summary (user-safe message)
  errorCode       String?   // Structured code for UI: AUTH_REQUIRED_FOR_AI, INSUFFICIENT_CREDITS, etc.
  recommendedAction String? // login | topup | adjust | fixInput | retry | startOver
  committedAt     DateTime? // Timestamp when draft was committed
  committedStoreId String?  // When committed, link to Business.id
  committedUserId  String?  // When committed, link to User.id
  ownerUserId     String?   // Set when draft is created by authed user, or when claimed via /api/draft-store/claim
  ownerUser       User?     @relation("DraftStoreOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  guestSessionId  String?   // Set when draft is created by guest (cookie/header); used for claim
  ipHash          String?   // Optional: hashed IP for rate limiting
  userAgent       String?   // Optional: user agent string
  brandTone       String?   // e.g. luxury, friendly, minimal, bold
  brandStyle      String?   // e.g. modern, vintage, playful
  brandColors     String?   // JSON array string e.g. '["pink","gold"]'
  unclaimedStoreId String?  // Link to UnclaimedStore when pre-built from discovery agent
  transferredAt   DateTime? // When pre-built draft transferred to claimer
  phone           String?
  email           String?
  websiteUrl      String?
  address         String?
  addressLine2    String?
  suburb          String?
  city            String?
  state           String?
  postcode        String?
  country         String?
  formattedAddress String?
  locationSource  String?
  locationConfidence String?
  osmPlaceId      String?
  mapUrl          String?
  lat             Float?
  lng             Float?

  workflowRuns WorkflowRun[]     // Phase 1: workflow tracking (e.g. store_creation)
  workflowIncidents WorkflowIncident[]

  @@index([expiresAt])
  @@index([unclaimedStoreId])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([committedStoreId])
  @@index([committedUserId])
  @@index([ownerUserId])
  @@index([guestSessionId])
}

// Phase 1: Make One Workflow Real (workflowKey = store_creation)
model WorkflowRun {
  id            String    @id @default(cuid())
  workflowKey   String    // e.g. "store_creation"
  draftStoreId  String?   // Optional link to DraftStore
  startedAt     DateTime  @default(now())
  endedAt       DateTime? // Set when run completes or fails
  status        String    // e.g. "running" | "completed" | "failed"
  failureCode   String?   // Structured code when status = failed
  meta          Json?     // Optional extra payload
  createdAt     DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  draftStore    DraftStore? @relation(fields: [draftStoreId], references: [id], onDelete: SetNull)
  incidents     WorkflowIncident[]

  @@index([workflowKey])
  @@index([draftStoreId])
  @@index([startedAt])
  @@index([status])
}

model WorkflowIncident {
  id           String    @id @default(cuid())
  workflowKey  String
  severity     String    // e.g. "warning" | "error" | "critical"
  draftStoreId String?
  runId        String?
  reasonKey    String    // Structured reason code
  summary      String
  evidence     Json      // JSON blob (logs, payload snippet, etc.)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  draftStore   DraftStore?   @relation(fields: [draftStoreId], references: [id], onDelete: SetNull)
  run          WorkflowRun?  @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([workflowKey])
  @@index([draftStoreId])
  @@index([runId])
  @@index([createdAt])
}

model WorkflowReport {
  id         String   @id @default(cuid())
  workflowKey String
  periodStart DateTime
  periodEnd   DateTime
  payload    Json     // Aggregated metrics/summary JSON
  createdAt  DateTime @default(now())

  @@index([workflowKey])
  @@index([periodStart, periodEnd])
}

// Phase 0: In-app notifications (e.g. QA autofix). userId can be User.id or guest_<sessionId>.
model Notification {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  userId    String
  draftId   String?
  type      String    // 'qa_autofix'
  title     String
  message   String
  meta      Json?
  readAt    DateTime?

  @@index([userId, createdAt])
}

// Seed catalog cache: fetched item names per vertical when no template pack exists (Wikidata/open data).
model SeedCatalog {
  id           String   @id @default(cuid())
  verticalSlug String   // e.g. entertainment.game_centre, retail.furniture
  subIntent    String   @default("") // e.g. "" or "kids" for fashion.kids
  itemsJson    String   // JSON array of { name: string, description?: string }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([verticalSlug, subIntent])
  @@index([verticalSlug])
  @@index([updatedAt])
}

// Content ingest samples (dev-only, gated by ENABLE_CONTENT_INGEST_LOGS) for Content Library datasets
model ContentIngestSample {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  generationRunId      String?
  jobId                String?
  draftId              String?
  sourceType           String    // "form"|"voice"|"ocr"|"url"|"template"
  goal                 String    // "build_store"|"build_store_from_menu"|...
  mode                 String    // "ai"|"template"|"ocr"
  includeImages        Boolean   @default(true)
  templateKey         String?
  websiteDomain       String?
  vertical             String?
  rawInputSanitized    String?   // max 800 chars, PII-scrubbed
  ocrTextSanitized    String?   // max 1200 chars, PII-scrubbed; only for OCR
  outputCatalog        Json      // { categories: [{ name }], items: [{ name, description?, categoryName? }] }
  meta                 Json?    // optional: locale, currency, itemCount, categoryCount

  @@index([createdAt])
  @@index([sourceType])
  @@index([goal])
  @@index([draftId])
}

// Smart Object - Dynamic QR codes for print/landing (e.g. print bag -> /q/:publicCode)
model SmartObject {
  id            String   @id @default(cuid())
  publicCode    String   @unique // Short code for /q/:publicCode
  storeId       String
  productId     String?
  type          String   @default("print_bag") // print_bag | promo_card | sticker | other
  status        String   @default("active")
  activePromoId String?  // Content.id or PromoInstance id - promo shown when scanning QR
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([storeId])
  @@index([publicCode])
  @@index([status])
}

// Intent Capture MVP: public offer page (title, price, description, store, CTA). Created from Mission only.
model StoreOffer {
  id          String    @id @default(cuid())
  storeId     String
  slug        String    // URL slug for /p/:storeSlug/offers/:slug (unique per store)
  title       String
  description String?
  priceText   String?   // e.g. "$10" or "Free"
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store Business @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([isActive])
}

// Intent Capture: page view + QR scan signals (no auth).
model IntentSignal {
  id        String   @id @default(cuid())
  type      String   // "page_view" | "qr_scan" | "offer_view"
  storeId   String
  offerId   String?
  code      String?  // QR code scanned (e.g. DynamicQr.code)
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([offerId])
  @@index([type, createdAt])
}

// Public storefront / feed interaction aggregates (views, loves, claps, etc.).
model ContentInteractionMetrics {
  id            String   @id @default(cuid())
  contentType   String
  contentId     String
  storeId       String?
  artifactId    String?
  viewsCount    Int      @default(0)
  lovesCount    Int      @default(0)
  clapsCount    Int      @default(0)
  commentsCount Int      @default(0)
  sharesCount   Int      @default(0)
  bookingsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  viewerStates ContentInteractionViewerState[]

  @@unique([contentType, contentId])
  @@index([storeId])
  @@index([artifactId])
}

model ContentInteractionViewerState {
  id        String   @id @default(cuid())
  metricsId String
  viewerKey String
  loved     Boolean  @default(false)
  clapAdds  Int      @default(0)
  shared    Boolean  @default(false)
  viewed    Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  metrics ContentInteractionMetrics @relation(fields: [metricsId], references: [id], onDelete: Cascade)

  @@unique([metricsId, viewerKey])
  @@index([viewerKey])
}

// Canonical store engagement — every interaction writes StoreActivityEvent; snapshots are derived.
model StoreActivityEvent {
  id           String   @id @default(cuid())
  storeId      String
  actorUserId  String?
  sessionId    String?
  eventType    String
  source       String
  metadataJson Json?
  createdAt    DateTime @default(now())

  business Business @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, eventType])
  @@index([storeId, createdAt])
  @@index([eventType, createdAt])
  @@index([storeId, sessionId, eventType, createdAt])
}

model StoreEngagementSnapshot {
  storeId          String   @id
  followersCount   Int      @default(0)
  likesCount       Int      @default(0)
  savesCount       Int      @default(0)
  sharesCount      Int      @default(0)
  viewsCount       Int      @default(0)
  views24h         Int      @default(0)
  views7d          Int      @default(0)
  qrScansCount     Int      @default(0)
  orderClicksCount Int      @default(0)
  callClicksCount  Int      @default(0)
  offerClaimsCount Int      @default(0)
  engagementScore  Int      @default(0)
  updatedAt        DateTime @updatedAt

  business Business @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model StoreFollow {
  id        String   @id @default(cuid())
  storeId   String
  actorKey  String
  userId    String?
  createdAt DateTime @default(now())

  business Business @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, actorKey])
  @@index([storeId])
  @@index([userId])
}

model StoreReaction {
  id        String   @id @default(cuid())
  storeId   String
  actorKey  String
  userId    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, actorKey])
  @@index([storeId])
}

model StoreSave {
  id        String   @id @default(cuid())
  storeId   String
  actorKey  String
  userId    String?
  createdAt DateTime @default(now())

  business Business @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, actorKey])
  @@index([storeId])
}

model StoreShare {
  id        String   @id @default(cuid())
  storeId   String
  actorKey  String
  userId    String?
  source    String?
  createdAt DateTime @default(now())

  business Business @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, createdAt])
}

model OfferClaim {
  id        String   @id @default(cuid())
  storeId   String
  offerId   String
  actorKey  String
  userId    String?
  createdAt DateTime @default(now())

  business Business @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([offerId])
  @@index([storeId, offerId])
}

// IntentOpportunity v0: derived from IntentSignal; accepted -> IntentRequest (single runway).
model IntentOpportunity {
  id                    String   @id @default(cuid())
  storeId               String
  offerId               String?
  type                  String   // e.g. high_views_no_qr, low_traffic, recent_interest
  severity              String   @default("medium") // high | medium | low
  status                String   @default("open")   // open | accepted | later | dismissed
  summary               String
  evidence              Json?    // counts, window, etc.
  recommendedIntentType String   // e.g. create_offer, create_qr_for_offer
  payload               Json?    // suggested payload for IntentRequest
  source                String   @default("rules")  // rules | llm_inference
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, source])
  @@index([createdAt])
}

// Last opportunity inference run per store (for trigger: avoid re-running too frequently).
model OpportunityInferenceRun {
  id         String   @id @default(cuid())
  storeId    String   @unique
  lastRunAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([lastRunAt])
}

// Dynamic QR v0 - Editable destination (loyalty/discount/storefront/offer), same printed QR can be updated
model DynamicQr {
  id               String    @id @default(cuid())
  code             String    @unique // Short code for /q/:code
  storeId          String
  type             String    // "storefront" | "loyalty" | "discount"
  payload          Json?     // e.g. { promoId?, publicId?, percent?, code?, expiresAt? }
  targetPath       String?   // Optional override path (relative or full)
  isActive         Boolean   @default(true)
  createdByUserId  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  scanEvents ScanEvent[]

  @@index([storeId])
  @@index([code])
  @@index([isActive])
}

// Scan event - one row per scan of a Dynamic QR (for analytics)
model ScanEvent {
  id          String    @id @default(cuid())
  dynamicQrId String
  dynamicQr   DynamicQr  @relation(fields: [dynamicQrId], references: [id], onDelete: Cascade)
  storeId     String
  scannedAt   DateTime  @default(now())
  userAgent   String?
  referer     String?

  @@index([dynamicQrId])
  @@index([storeId])
  @@index([scannedAt])
}

// --- Legal Seed Library (ingested assets from Unsplash/Pexels/Pixabay etc.) ---
// Used for image autofill; does not touch Draft → Preview → Publish flow.

model SeedAsset {
  id                String    @id @default(cuid())
  provider          String    // e.g. "unsplash" | "pexels" | "pixabay"
  providerAssetId   String    // provider's photo/asset id
  sourcePageUrl     String?   // canonical page URL for attribution
  photographerName  String?
  photographerUrl   String?
  licenseName       String?
  licenseUrl        String?
  attributionText   String?   // preformatted attribution line
  width             Int?
  height            Int?
  orientation       String?   // "landscape" | "portrait" | "square"
  tags              Json?     // JSON array of strings
  vertical          String?   // e.g. "food" | "beauty" | "services"
  categoryKey       String?   // e.g. "nails" | "burger" | "dessert"
  sha256            String?   // hash of file for dedupe (unique when set)
  status            String    @default("active") // "active" | "disabled" | "failed_validation" | "rejected"
  rejectReason      String?   // optional reason when status=rejected (banlist)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  files             SeedAssetFile[]
  ingestionJob      SeedIngestionJob? @relation("SeedIngestionJobAssets", fields: [ingestionJobId], references: [id], onDelete: SetNull)
  ingestionJobId    String?

  @@unique([provider, providerAssetId])
  @@unique([sha256])
  @@index([provider])
  @@index([vertical])
  @@index([categoryKey])
  @@index([status])
  @@index([ingestionJobId])
}

model SeedAssetFile {
  id         String    @id @default(cuid())
  seedAssetId String
  seedAsset   SeedAsset @relation(fields: [seedAssetId], references: [id], onDelete: Cascade)
  fileUrl    String    // full URL to image (or path if stored locally)
  role       String    @default("full") // "full" | "thumb" | "small" | "medium"
  width      Int?
  height     Int?
  mimeType   String?
  createdAt  DateTime  @default(now())

  @@index([seedAssetId])
  @@index([role])
}

model SeedIngestionJob {
  id            String    @id @default(cuid())
  provider      String?   // e.g. "unsplash" | "pexels"
  status        String    @default("running") // "running" | "completed" | "failed" | "cancelled"
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  meta          Json?     // e.g. { query, limit, cursor, fetchedCount }
  errorMessage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assets        SeedAsset[] @relation("SeedIngestionJobAssets")

  @@index([provider])
  @@index([status])
  @@index([startedAt])
}

// ============================================
// Promotion Slot Pipeline v1 - shared promotion delivery
// (Mirrors prisma/schema.prisma for local SQLite.)
// ============================================

model Promotion {
  id           String    @id @default(cuid())
  storeId      String? // optional if global later
  type         String // e.g. "banner" | "popup" | "hero"
  title        String
  message      String?
  mediaType    String? // "image" | "video" | null
  mediaUrl     String?
  ctaLabel     String?
  ctaUrl       String?
  status       String    @default("draft") // draft | planned | active | expired | failed
  startAt      DateTime?
  endAt        DateTime?
  priority     Int       @default(0)
  metadataJson Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  placements PromotionPlacement[]

  @@index([storeId])
  @@index([status])
  @@index([startAt, endAt])
}

model PromotionSlot {
  id          String    @id @default(cuid())
  slotKey     String    @unique // e.g. store_entry_popup, homepage_hero, cnet_main_screen, qr_landing_banner
  surfaceType String // storefront | homepage | cnet | qr
  displayMode String // popup | hero | banner | inline | video
  isActive    Boolean   @default(true)
  configJson  Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  placements PromotionPlacement[]

  @@index([slotKey])
  @@index([isActive])
}

model PromotionPlacement {
  id           String    @id @default(cuid())
  promotionId  String
  slotId       String
  storeId      String? // optional if store-scoped
  enabled      Boolean   @default(true)
  startAt      DateTime?
  endAt        DateTime?
  priority     Int       @default(0)
  metadataJson Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  promotion Promotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  slot      PromotionSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([slotId])
  @@index([storeId])
  @@index([slotId, storeId])
  @@index([enabled])
}

model McpToken {
  id         String    @id @default(cuid())
  userId     String
  storeId    String
  tokenHash  String    @unique
  label      String    @default("MCP Token")
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@index([storeId])
  @@index([tokenHash])
}

// --- Contact Sync Phase 1 (SQLite test/dev; mirrors migration 20260409120000_add_contact_sync_phase1) ---

model UserIdentifier {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  hash        String
  hashVersion String    @default("v1")
  source      String    @default("email")
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([kind, hash, hashVersion])
  @@index([userId])
  @@index([kind, hash])
  @@index([verifiedAt])
}

model ContactSyncConsent {
  id            String    @id @default(cuid())
  userId        String
  status        String    @default("granted")
  policyVersion String
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  sources       ContactSyncSource[]

  @@index([userId, status])
  @@index([userId, grantedAt])
}

model ContactSyncSource {
  id                String             @id @default(cuid())
  userId            String
  consentId         String
  consent           ContactSyncConsent @relation(fields: [consentId], references: [id], onDelete: Cascade)
  platform          String
  deviceFingerprint String?
  status            String             @default("active")
  lastSyncAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  jobs              ContactSyncJob[]
  contactIdentifiers ContactIdentifier[]
  contactMatches    ContactMatch[]

  @@index([userId])
  @@index([consentId])
  @@index([status, lastSyncAt])
}

model ContactSyncJob {
  id         String            @id @default(cuid())
  sourceId   String
  source     ContactSyncSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status     String            @default("started")
  counts     Json?
  errorCode  String?
  startedAt  DateTime          @default(now())
  finishedAt DateTime?

  @@index([sourceId, startedAt])
  @@index([status, startedAt])
}

model ContactIdentifier {
  id          String            @id @default(cuid())
  sourceId    String
  source      ContactSyncSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  kind        String
  hash        String
  hashVersion String            @default("v1")
  firstSeenAt DateTime          @default(now())
  lastSeenAt  DateTime          @default(now())

  @@unique([sourceId, kind, hash, hashVersion])
  @@index([kind, hash])
  @@index([sourceId, lastSeenAt])
}

model ContactMatch {
  id            String            @id @default(cuid())
  sourceId      String
  source        ContactSyncSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  matchedUserId String
  matchBasis    String
  confidence    Float             @default(1.0)
  createdAt     DateTime          @default(now())
  lastSeenAt    DateTime          @default(now())

  @@unique([sourceId, matchedUserId])
  @@index([matchedUserId])
  @@index([sourceId, lastSeenAt])
}

model ContactSuggestion {
  id            String    @id @default(cuid())
  userId        String
  type          String
  matchedUserId String?
  rankScore     Float     @default(0)
  reasonCode    String?
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?

  @@index([userId, status, rankScore])
  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// User↔user connect / friend graph (Phase B). Not StoreFollow.
model UserConnection {
  id           String    @id @default(cuid())
  fromUserId   String
  toUserId     String
  status       String    @default("pending") // pending | accepted | rejected | blocked
  source       String    @default("direct") // direct | contact_suggestion | legacy_import
  suggestionId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  respondedAt  DateTime?

  fromUser User @relation("ConnectionFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ConnectionTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([status, updatedAt])
}

// ============================================
// Digital cards (Suitcase) — created by buildCard / create card missions
// ============================================
model Card {
  id               String   @id
  userId           String
  type             String
  title            String
  status           String   @default("active")
  designJson       Json
  agentPersonality String
  knowledgeBase    Json
  capabilities     String
  autoApprove      Boolean  @default(true)
  liveUrl          String
  qrCodeUrl        String?
  sizeW            Float
  sizeH            Float
  sizeUnit         String
  sizeDpi          Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============================================
// SmartDocument Layer — CC-1
// Polymorphic document with embedded agent, phase engine, and capability registry.
// ============================================
model SmartDocument {
  id               String    @id @default(cuid())
  userId           String
  businessId       String?
  docType          String    // card|ticket|report|badge|menu|flyer
  subtype          String?
  title            String
  status           String    @default("active") // active|expired|archived
  phase            String    @default("pre")    // pre|active|post

  designJson       String?
  renderedUrl      String?
  printUrl         String?
  qrCodeUrl        String?
  liveUrl          String?

  sizeW            Float?
  sizeH            Float?
  sizeUnit         String?   @default("mm")
  sizeDpi          Int?      @default(300)

  agentPersonality String?
  knowledgeBase    String?
  capabilities     String    @default("[]") // JSON array string
  autoApprove      Boolean   @default(true)

  phaseConfig      String?   // JSON: { startsAt?, endsAt?, maxStamps?, expireAfterDays? }

  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  conversations     DocConversation[]
  visitors          DocVisitor[]
  stamps            LoyaltyStamp[]
  redemptions       PromoRedemption[]
  rsvps             EventRsvp[]
  checkIns          DocCheckIn[]
  signatures        DocSignature[]
  scheduledMessages DocScheduledMessage[]

  @@index([userId, createdAt])
  @@index([businessId, createdAt])
  @@index([docType, status])
  @@index([phase, status])
}

model DocVisitor {
  id                String    @id @default(cuid())
  docId             String
  sessionToken      String    @unique
  phone             String?
  email             String?
  name              String?
  platformVisitorId String?
  firstSeenAt       DateTime  @default(now())
  lastSeenAt        DateTime  @updatedAt

  doc SmartDocument @relation(fields: [docId], references: [id], onDelete: Cascade)

  conversations DocConversation[]
  stamps        LoyaltyStamp[]
  redemptions   PromoRedemption[]
  rsvps         EventRsvp[]
  checkIns      DocCheckIn[]
  signatures    DocSignature[]

  @@index([docId, lastSeenAt])
  @@index([platformVisitorId])
}

model DocConversation {
  id        String    @id @default(cuid())
  docId     String
  visitorId String
  channel   String    @default("web") // web|sms|email
  messages  String    @default("[]")
  outcome   String?   // lead_captured|redeemed|rsvp|booked|abandoned
  intent    String?
  sentiment String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  doc     SmartDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  visitor DocVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([docId, updatedAt])
  @@index([visitorId, updatedAt])
  @@index([channel, createdAt])
}

model DocScheduledMessage {
  id        String    @id @default(cuid())
  docId     String
  sendAt    DateTime
  channel   String    @default("web") // web|sms|email
  payload   String?
  status    String    @default("pending") // pending|sent|failed|cancelled
  attempts  Int       @default(0)
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  doc SmartDocument @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, sendAt])
  @@index([status, sendAt])
}

model LoyaltyStamp {
  id         String        @id @default(cuid())
  docId      String
  visitorId  String
  stampedAt  DateTime      @default(now())
  redeemedAt DateTime?

  doc     SmartDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  visitor DocVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([docId, stampedAt])
  @@index([visitorId, stampedAt])
}

model PromoRedemption {
  id              String        @id @default(cuid())
  docId           String
  visitorId       String
  redeemedAt      DateTime      @default(now())
  discountApplied String?

  doc     SmartDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  visitor DocVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([docId, redeemedAt])
  @@index([visitorId, redeemedAt])
  @@map("DocumentPromoRedemption")
}

model EventRsvp {
  id        String        @id @default(cuid())
  docId     String
  visitorId String
  status    String        // attending|declined|maybe
  rsvpAt    DateTime      @default(now())

  doc     SmartDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  visitor DocVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([docId, rsvpAt])
  @@index([visitorId, rsvpAt])
}

model DocCheckIn {
  id          String        @id @default(cuid())
  docId       String
  visitorId   String
  checkedInAt DateTime      @default(now())
  note        String?

  doc     SmartDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  visitor DocVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([docId, checkedInAt])
  @@index([visitorId, checkedInAt])
}

model DocSignature {
  id           String        @id @default(cuid())
  docId        String
  visitorId    String
  signedAt     DateTime      @default(now())
  signatureUrl String?
  ipAddress    String?

  doc     SmartDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  visitor DocVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([docId, signedAt])
  @@index([visitorId, signedAt])
}

model PilEvent {
  id         String   @id @default(cuid())
  type       String
  timestamp  DateTime @default(now())
  sessionId  String?
  userId     String?
  entityType String?
  entityId   String?
  storeId    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([type, timestamp])
  @@index([sessionId])
  @@index([userId])
  @@index([storeId, timestamp])
  @@index([entityType, entityId])
}

model SkillDispatchLog {
  id            String   @id @default(cuid())
  traceId       String
  userId        String?
  sessionId     String?
  query         String
  intent        String
  matchedSkill  String?
  confidence    Float
  executionPath String?
  outcome       String?
  latencyMs     Int?
  createdAt     DateTime @default(now())
  feedback      SkillDispatchFeedback[]

  @@index([userId, createdAt])
