// --- Universal Library Population (ported for staging) ---

model UniversalAsset {
  id            String   @id @default(cuid())
  title         String
  description   String?
  type          String
  provider      String
  sourceUrl     String?
  license       String?
  categories    Json?
  tags          Json?
  language      String?
  country       String?
  ownerId       String?
  creatorId     String?
  thumbnail     String?
  preview       String?
  metadata      Json?
  rightsStatus  String   @default("UNKNOWN")
  hostingMode   String   @default("REFERENCE")
  qualityScore  Float    @default(0)
  status        String   @default("DISCOVERED")
  duplicateOfId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  duplicateOf    UniversalAsset?           @relation("UniversalAssetDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates     UniversalAsset[]          @relation("UniversalAssetDuplicate")
  relationsFrom  UniversalAssetRelation[]  @relation("UniversalAssetRelationFrom")
  relationsTo    UniversalAssetRelation[]  @relation("UniversalAssetRelationTo")
  discoveryScore UniversalDiscoveryScore?

  @@index([status])
  @@index([provider])
  @@index([type])
  @@index([rightsStatus])
}

model UniversalAssetRelation {
  id           String   @id @default(cuid())
  fromAssetId  String
  toAssetId    String
  relationType String
  weight       Float?
  metadata     Json?
  createdAt    DateTime @default(now())

  fromAsset UniversalAsset @relation("UniversalAssetRelationFrom", fields: [fromAssetId], references: [id], onDelete: Cascade)
  toAsset   UniversalAsset @relation("UniversalAssetRelationTo", fields: [toAssetId], references: [id], onDelete: Cascade)

  @@unique([fromAssetId, toAssetId, relationType])
  @@index([fromAssetId])
  @@index([toAssetId])
}

model ContentPopulationJob {
  id          String    @id @default(cuid())
  kind        String
  provider    String?
  status      String
  attempt     Int       @default(0)
  maxAttempts Int       @default(3)
  payload     Json?
  result      Json?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  @@index([status])
  @@index([kind])
}

model UniversalEntity {
  id        String   @id @default(cuid())
  kind      String
  name      String
  slug      String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relationsFrom UniversalEntityRelation[] @relation("UniversalEntityRelationFrom")
  relationsTo   UniversalEntityRelation[] @relation("UniversalEntityRelationTo")

  @@unique([kind, slug])
  @@index([kind])
}

model UniversalEntityRelation {
  id           String   @id @default(cuid())
  fromEntityId String
  toEntityId   String
  relationType String
  weight       Float?
  createdAt    DateTime @default(now())

  fromEntity UniversalEntity @relation("UniversalEntityRelationFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   UniversalEntity @relation("UniversalEntityRelationTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([fromEntityId, toEntityId, relationType])
}

model MarketplacePurchase {
  id          String   @id @default(cuid())
  listingId   String
  buyerUserId String
  amountCents Int      @default(0)
  currency    String   @default("AUD")
  licenseCode String?
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now())

  @@index([buyerUserId])
  @@index([listingId])
}

model UniversalDiscoveryScore {
  assetId         String   @id
  discoveryScore  Float    @default(0)
  trendingScore   Float    @default(0)
  qualityScore    Float    @default(0)
  trustScore      Float    @default(0)
  popularityScore Float    @default(0)
  signals         Json?
  updatedAt       DateTime @updatedAt

  asset UniversalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

/// Cardbey Live Market — pilot enrolment (one active row per store).
model LiveMarketPilotEnrollment {
  id                         String    @id @default(cuid())
  storeId                    String    @unique
  store                      Business  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  state                      String    @default("INVITED")
  approvedHostUserIds        Json?
  allowedSourceLanguages     Json?
  allowedTargetLanguages     Json?
  maxSessionDurationMinutes  Int?
  recordingAllowed           Boolean   @default(true)
  automaticReplayPublication Boolean   @default(true)
  approvedAt                 DateTime?
  approvedByActorId          String?
  pausedAt                   DateTime?
  pausedByActorId            String?
  removedAt                  DateTime?
  removedByActorId           String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([state])
  @@index([storeId, state])
}

/// Live session lifecycle record (provider-neutral). Not a broadcast claim by itself.
model LiveMarketSession {
  id                          String   @id @default(cuid())
  storeId                     String
  store                       Business @relation(fields: [storeId], references: [id], onDelete: Cascade)
  hostUserId                  String
  title                       String
  description                 String?
  sourceLanguage              String   @default("vi")
  viewerLanguages             Json?
  scheduledStartAt            DateTime?
  startedAt                   DateTime?
  endedAt                     DateTime?
  state                       String   @default("DRAFT")
  /// Editorial storefront announcement — independent of media LIVE.
  storefrontPublicationStatus String   @default("HIDDEN")
  storefrontPublishedAt       DateTime?
  recordingEnabled            Boolean  @default(true)
  automaticReplayPublication  Boolean  @default(true)
  providerExternalRef         String?
  endReasonCode               String?
  failureReasonCode           String?
  version                     Int      @default(1)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  subjects                    LiveMarketSessionSubject[]
  participantRegistrations    LiveMarketParticipantRegistration[]

  @@index([storeId])
  @@index([storeId, state])
  @@index([storeId, storefrontPublicationStatus, scheduledStartAt])
  @@index([hostUserId])
  @@index([state, scheduledStartAt])
  @@index([scheduledStartAt])
}

/// Session subjects reference Product.id (products and services). No catalog field copies.
model LiveMarketSessionSubject {
  id          String            @id @default(cuid())
  sessionId   String
  session     LiveMarketSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subjectType String
  subjectId   String
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())

  @@unique([sessionId, subjectType, subjectId])
  @@index([sessionId])
  @@index([subjectId])
}

/// Audience registration for published Global Live sessions (not viewers / not LIVE).
model LiveMarketParticipantRegistration {
  id                   String            @id @default(cuid())
  sessionId            String
  session              LiveMarketSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  storeId              String
  store                Business          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredLanguage    String
  questionForHost      String?
  /// Host inbox review state when a question exists — NEW|REVIEWED|PLANNED|ANSWERED|DISMISSED
  questionReviewStatus String?
  interestSubjectId    String?
  interestSubjectType  String?
  status               String            @default("REGISTERED")
  registeredAt         DateTime          @default(now())
  cancelledAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([sessionId, userId])
  @@index([storeId, status])
  @@index([userId, status, registeredAt])
  @@index([sessionId, status])
  @@index([sessionId, questionReviewStatus])
}

/// Marketing EOI for Cardbey Global Live pilots (not Live Market session registration).
model GlobalLiveEoiRegistration {
  id                      String    @id @default(cuid())
  /// Stable pilot identifier (e.g. vn_au_global_live_v1). Not hard-coded to one corridor.
  pilotId                 String
  userId                  String?
  storeId                 String?
  name                    String
  businessName            String
  industry                String
  city                    String
  country                 String    @default("Vietnam")
  phone                   String
  email                   String
  /// Lowercased trimmed email for soft dedupe (never used as account-existence signal)
  emailNormalized         String
  showcaseTypes           Json
  businessDescription     String
  /// yes | no | not_sure
  existingCardbeyBusiness String
  businessUrl             String?
  language                String?
  source                  String?
  campaign                String?
  utmSource               String?
  utmMedium               String?
  utmCampaign             String?
  utmContent              String?
  referrer                String?
  socialProvider          String?
  consentGranted          Boolean   @default(false)
  consentAt               DateTime?
  /// Server-authoritative EOI consent artifact id (e.g. global-live-eoi-consent-v1). Null = legacy/unversioned.
  consentVersion          String?
  privacyVersion          String?
  termsVersion            String?
  consentLocale           String?
  /// e.g. GLOBAL_LIVE_EOI
  consentContext          String?
  /// SHA-256 hex of canonical consent text shown for consentVersion + locale
  consentTextHash         String?
  /// SUBMITTED | UNDER_REVIEW | SHORTLISTED | SELECTED | WAITLISTED | DECLINED | WITHDRAWN
  status                  String    @default("SUBMITTED")
  /// Opaque public receipt reference (never the Prisma cuid)
  publicReference         String    @unique
  /// sent | skipped | failed — delivery outcome only; no rendered body stored
  confirmationEmailStatus String?
  confirmationSentAt      DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([pilotId, status])
  @@index([pilotId, emailNormalized])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([userId])
  @@index([emailNormalized])
}
