  title       String
  description String?
  duration    Int?
  remoteUrl   String?
  storageUrl  String?
  storageKey  String?
  license     String
  attribution String?
  tags        Json?
  metadata    Json?
  storeId     String?
  uploadedBy  String?
  isSeeded    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([source])
  @@index([title])
  @@index([storeId])
  @@index([uploadedBy])
