// Creator Foundation Phase 1 — canonical creator entity (one per account)
model Creator {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String?
  username              String   @unique
  avatar                String?
  banner                String?
  bio                   String?
  languages             Json? // string[]
  country               String?
  categories            Json? // string[]
  verifiedStatus        String   @default("unverified")
  joinedAt              DateTime @default(now())
  totalPublishedMinutes Float    @default(0)
  totalVideos           Int      @default(0)
  totalArticles         Int      @default(0)
  totalViews            Int      @default(0)
  followers             Int      @default(0)
  following             Int      @default(0)
  creatorLevel          Int      @default(1)
  creatorStatus         String   @default("active")
  qualificationProgress Float    @default(0)
  isQualified           Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  contents CreatorContent[]
