  @@index([templateVersionId])
  @@index([templateInstanceId])
}

model TemplateFavorite {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  createdAt  DateTime @default(now())

  @@unique([userId, templateId])
  @@index([userId])
}

// MI Greeting Cards - User-generated greeting cards with sharing
model GreetingCard {
