  @@index([username])
  @@index([creatorStatus])
  @@index([joinedAt])
}

/// Creator Rewards V1 — payout destination (Stripe Connect preferred; encrypted manual fallback).
/// Never expose encryptedPayload or full bank/tax values via API.
model CreatorPayoutAccount {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorId          String    @unique
  creator            Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  provider           String // stripe_connect | manual | other
  providerAccountId  String?
  country            String
  currency           String?
  accountType        String    @default("individual") // individual | business
  status             String    @default("not_started")
  payoutsEnabled     Boolean   @default(false)
  chargesEnabled     Boolean   @default(false)
  requirementsDue    Json?
  displayName        String?
  /// Encrypted JSON of sensitive payout fields (manual provider only). Never return to clients.
  encryptedPayload   String?
  accountLast4       String?
  bankNameMasked     String?
  legalNameMasked    String?
  taxIdLast4         String?
  lastProviderEventId String?
  submittedAt        DateTime?
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([providerAccountId])
  @@index([status])
  @@index([provider])
}

