  creatorId       String
  reason          String
  status          String    @default("pending")
  resolutionNote  String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([contentId])
  @@index([creatorId])
  @@index([status])
}

// MI Video Templates - Video background templates for greeting cards
model MiVideoTemplate {
