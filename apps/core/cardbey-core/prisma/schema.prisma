// ============================================
// Intent Graph v1 - Store/draft intent graph (rules-first, no graph DB)
// Built after DraftStore is generated; used for next-best actions and offer-intent matching.
// ============================================

// Intent node: one inferred intent for a draft or store (e.g. promote_breakfast, highlight_pastries).
// Later: consider IntentType table (intentKey FK) to prevent typo drift and attach metadata.
model IntentNode {
  id           String    @id @default(cuid())
  draftStoreId String?   // Draft scope (before commit)
  storeId      String?   // Store scope (after commit or for committed stores)
  intentKey    String    // e.g. "promote_breakfast", "highlight_pastries"
  label        String    // Human-readable label
  weight       Float     @default(0.5) // 0-1 priority/ordering
  confidence   Float?    // 0-1 inference confidence (e.g. 0.82); display/explainability
  source       String    @default("rules") // "rules" | "rules_engine" | "ai" (v1: rules only)
  createdAt    DateTime  @default(now())

  edgesFrom    IntentEdge[] @relation("IntentEdgeFrom")
  edgesTo      IntentEdge[] @relation("IntentEdgeTo")
  signals      IntentGraphSignal[]
  offerMatches OfferIntentMatch[]

  @@index([draftStoreId])
  @@index([storeId])
  @@index([intentKey])
  @@index([draftStoreId, intentKey])
  @@index([storeId, intentKey])
}

// Edge between two intent nodes (optional for v1; supports | conflicts).
model IntentEdge {
  id        String    @id @default(cuid())
  fromId    String
  toId      String
  fromNode  IntentNode @relation("IntentEdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toNode    IntentNode @relation("IntentEdgeTo", fields: [toId], references: [id], onDelete: Cascade)
  kind      String?   // "supports" | "conflicts" | null
  createdAt DateTime  @default(now())

  @@unique([fromId, toId])
  @@index([fromId])
  @@index([toId])
}

// Evidence signal that contributed to inferring an intent (rules-first: category names, item keywords, etc.).
model IntentGraphSignal {
  id         String    @id @default(cuid())
  intentNodeId String
  intentNode   IntentNode @relation(fields: [intentNodeId], references: [id], onDelete: Cascade)
  signalType   String    // e.g. "category_match", "item_keyword", "business_type"
  signalValue  String    // e.g. "Pastries", "croissant", "bakery"
  strength     Float     @default(1)   // 0-1
  createdAt    DateTime  @default(now())

  @@index([intentNodeId])
  @@index([signalType])
}

// Match between an offer/item/category and an intent (score + evidence).
model OfferIntentMatch {
  id           String    @id @default(cuid())
  intentNodeId String
  intentNode   IntentNode @relation(fields: [intentNodeId], references: [id], onDelete: Cascade)
  offerType    String    // "product" | "category" | "item" (draft item from preview)
  offerRef     String    // id or slug of the product/category/item
  draftStoreId  String?   // When from draft
  storeId      String?   // When from committed store
  score        Float     @default(0) // 0-1 match score
  evidence     Json?     // { reason, matchedTerms?, source, scoreBreakdown?: { categoryFit?, itemFit?, storeTypeBoost?, keywordMatch? } }
  createdAt    DateTime  @default(now())

  @@index([intentNodeId])
  @@index([draftStoreId])
  @@index([storeId])
  @@index([offerType, offerRef])
}

// Top-ranked next-best action suggestion for a store/draft.
model StoreActionSuggestion {
  id            String    @id @default(cuid())
  draftStoreId  String?
  storeId       String?
  rank          Int       // 1-based (1 = top)
  actionType    String    // e.g. "create_promo", "add_qr", "publish"
  title         String
  description   String?
  payload       Json?     // action-specific params
  status        String    @default("active") // "active" | "applied" | "dismissed" | "expired"
  cooldownUntil DateTime? // when null or past: suggestion can show; set after dismiss to avoid repeat
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  outcomes     ActionOutcome[]

  @@index([draftStoreId])
  @@index([storeId])
  @@index([status])
  @@index([draftStoreId, status])
  @@index([storeId, status])
  @@index([cooldownUntil])
}

// Audit: outcome when user/system acts on a suggestion (applied, dismissed, expired).
model ActionOutcome {
  id           String    @id @default(cuid())
  suggestionId String
  suggestion   StoreActionSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  outcome      String    // "applied" | "dismissed" | "expired"
  actorType    String    @default("human") // "human" | "system"
  actorId      String?
  createdAt    DateTime  @default(now())

  @@index([suggestionId])
  @@index([outcome])
  @@index([createdAt])
}

// Dynamic QR v0 - Editable destination (loyalty/discount/storefront/offer), same printed QR can be updated
model DynamicQr {
  id               String    @id @default(cuid())
  code             String    @unique // Short code for /q/:code
  storeId          String
  type             String    // "storefront" | "loyalty" | "discount"
  payload          Json?     // e.g. { promoId?, publicId?, percent?, code?, expiresAt? }
  targetPath       String?   // Optional override path (relative or full)
  isActive         Boolean   @default(true)
  createdByUserId  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  scanEvents ScanEvent[]

  @@index([storeId])
  @@index([code])
  @@index([isActive])
}

// Scan event - one row per scan of a Dynamic QR (for analytics)
model ScanEvent {
  id          String    @id @default(cuid())
  dynamicQrId String
  dynamicQr   DynamicQr  @relation(fields: [dynamicQrId], references: [id], onDelete: Cascade)
  storeId     String
  scannedAt   DateTime  @default(now())
  userAgent   String?
  referer     String?

  @@index([dynamicQrId])
  @@index([storeId])
  @@index([scannedAt])
}

// --- Legal Seed Library (ingested assets from Unsplash/Pexels/Pixabay etc.) ---
// Used for image autofill; does not touch Draft → Preview → Publish flow.

model SeedAsset {
  id                String    @id @default(cuid())
  provider          String    // e.g. "unsplash" | "pexels" | "pixabay"
  providerAssetId   String    // provider's photo/asset id
  sourcePageUrl     String?   // canonical page URL for attribution
  photographerName  String?
  photographerUrl   String?
  licenseName       String?
  licenseUrl        String?
  attributionText   String?   // preformatted attribution line
  width             Int?
  height            Int?
  orientation       String?   // "landscape" | "portrait" | "square"
  tags              Json?     // JSON array of strings
  vertical          String?   // e.g. "food" | "beauty" | "services"
  categoryKey       String?   // e.g. "nails" | "burger" | "dessert"
  sha256            String?   // hash of file for dedupe (unique when set)
  status            String    @default("active") // "active" | "disabled" | "failed_validation" | "rejected"
  rejectReason      String?   // optional reason when status=rejected (banlist)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  files             SeedAssetFile[]
  ingestionJob      SeedIngestionJob? @relation("SeedIngestionJobAssets", fields: [ingestionJobId], references: [id], onDelete: SetNull)
  ingestionJobId    String?

  @@unique([provider, providerAssetId])
  @@unique([sha256])
  @@index([provider])
  @@index([vertical])
  @@index([categoryKey])
  @@index([status])
  @@index([ingestionJobId])
}

model SeedAssetFile {
  id         String    @id @default(cuid())
  seedAssetId String
  seedAsset   SeedAsset @relation(fields: [seedAssetId], references: [id], onDelete: Cascade)
  fileUrl    String    // full URL to image (or path if stored locally)
  role       String    @default("full") // "full" | "thumb" | "small" | "medium"
  width      Int?
  height     Int?
  mimeType   String?
  createdAt  DateTime  @default(now())

  @@index([seedAssetId])
  @@index([role])
}

model SeedIngestionJob {
  id            String    @id @default(cuid())
  provider      String?   // e.g. "unsplash" | "pexels"
  status        String    @default("running") // "running" | "completed" | "failed" | "cancelled"
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  meta          Json?     // e.g. { query, limit, cursor, fetchedCount }
  errorMessage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assets        SeedAsset[] @relation("SeedIngestionJobAssets")

  @@index([provider])
  @@index([status])
  @@index([startedAt])
}

// ============================================
// Promotion Slot Pipeline v1 - shared promotion delivery
// Promotions → Placements → Slots; resolver returns best promotion per slot.
// ============================================

model Promotion {
  id           String    @id @default(cuid())
  storeId      String?   // optional if global later
  type         String    // e.g. "banner" | "popup" | "hero"
  title        String
  message      String?
  mediaType    String?   // "image" | "video" | null
  mediaUrl     String?
  ctaLabel     String?
  ctaUrl       String?
  status       String    @default("draft") // draft | planned | active | expired | failed
  startAt      DateTime?
  endAt        DateTime?
  priority     Int       @default(0)
  metadataJson Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  placements   PromotionPlacement[]

  @@index([storeId])
  @@index([status])
  @@index([startAt, endAt])
}

model PromotionSlot {
  id          String    @id @default(cuid())
  slotKey     String    @unique // e.g. store_entry_popup, homepage_hero, cnet_main_screen, qr_landing_banner
  surfaceType String    // storefront | homepage | cnet | qr
  displayMode String    // popup | hero | banner | inline | video
  isActive    Boolean   @default(true)
  configJson  Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  placements  PromotionPlacement[]

  @@index([slotKey])
  @@index([isActive])
}

model PromotionPlacement {
  id          String    @id @default(cuid())
  promotionId String
  slotId      String
  storeId     String?   // optional if store-scoped
  enabled     Boolean   @default(true)
  startAt     DateTime?
  endAt       DateTime?
  priority    Int       @default(0)
  metadataJson Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  promotion   Promotion    @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  slot        PromotionSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([slotId])
  @@index([storeId])
  @@index([slotId, storeId])
  @@index([enabled])
}

// Per-store MCP client tokens (hash-only storage). Used by external MCP transport (SSE + JSON-RPC).
model McpToken {
  id         String    @id @default(cuid())
  userId     String
  storeId    String
  tokenHash  String    @unique
  label      String    @default("MCP Token")
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@index([storeId])
  @@index([tokenHash])
}

// External Connections: OAuth-backed rows for push (and future pull where OAuth applies).
// Platform strings are stable API/storage keys; see lib/externalConnections/providers PRISMA_OAUTH_PLATFORM.
model OAuthConnection {
  id           String    @id @default(cuid())
  userId       String
  platform     String // 'facebook' | 'instagram' | 'zalo' | 'google'
  accessToken  String // AES-256-GCM encrypted
  refreshToken String? // AES-256-GCM encrypted
  expiresAt    DateTime?
  pageId       String? // Facebook Page ID
  pageName     String? // Facebook Page display name
  scopes       String? // comma-separated granted scopes
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, platform, pageId])
  @@index([userId, platform])
}

// User-scoped API keys, bot tokens, and webhooks for extended social + LLM platforms.
model PlatformConnection {
  id             String    @id @default(cuid())
  userId         String
  platformId     String
  credentialsEnc String
  status         String    @default("active") // active | inactive
  expiresAt      DateTime?
  disconnectedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, platformId])
  @@index([userId, platformId])
  @@index([userId, status])
}

// ============================================
// Digital cards (Suitcase) — created by buildCard / create card missions
// ============================================
model Card {
  id               String   @id
  userId           String
  type             String
  title            String
  status           String   @default("active")
  designJson       Json
  agentPersonality String
  knowledgeBase    Json
  capabilities     String
  autoApprove      Boolean  @default(true)
  liveUrl          String
  qrCodeUrl        String?
  sizeW            Float
  sizeH            Float
  sizeUnit         String
  sizeDpi          Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============================================
// SmartDocument Layer — CC-1
// Polymorphic document with embedded agent, phase engine, and capability registry.
// ============================================
model SmartDocument {
  id               String    @id @default(cuid())
  userId           String
  businessId       String?
  docType          String    // card|ticket|report|badge|menu|flyer
  subtype          String?
  title            String
  status           String    @default("active") // active|expired|archived
  phase            String    @default("pre")    // pre|active|post

  designJson       Json?
  renderedUrl      String?
  printUrl         String?
  qrCodeUrl        String?
  liveUrl          String?

  sizeW            Float?
  sizeH            Float?
  sizeUnit         String?   @default("mm")
  sizeDpi          Int?      @default(300)

  agentPersonality String?
  knowledgeBase    Json?
  capabilities     String    @default("[]") // JSON array string
  autoApprove      Boolean   @default(true)

  phaseConfig      Json?     // { startsAt?, endsAt?, maxStamps?, expireAfterDays? }

  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  conversations     DocConversation[]
  visitors          DocVisitor[]
  stamps            LoyaltyStamp[]
  redemptions       PromoRedemption[]
  rsvps             EventRsvp[]
  checkIns          DocCheckIn[]
  signatures        DocSignature[]
  scheduledMessages DocScheduledMessage[]

  @@index([userId, createdAt])
  @@index([businessId, createdAt])
  @@index([docType, status])
  @@index([phase, status])
}

model DocVisitor {
  id                String    @id @default(cuid())
  docId             String
  sessionToken      String    @unique
  phone             String?
  email             String?
  name              String?
  platformVisitorId String?
  firstSeenAt       DateTime  @default(now())
  lastSeenAt        DateTime  @updatedAt

  doc SmartDocument @relation(fields: [docId], references: [id], onDelete: Cascade)

  conversations DocConversation[]
  stamps        LoyaltyStamp[]
  redemptions   PromoRedemption[]
  rsvps         EventRsvp[]
  checkIns      DocCheckIn[]
  signatures    DocSignature[]

  @@index([docId, lastSeenAt])
  @@index([platformVisitorId])
}

model DocConversation {
  id        String    @id @default(cuid())
  docId     String
  visitorId String
  channel   String    @default("web") // web|sms|email
  messages  String    @default("[]")
  outcome   String?   // lead_captured|redeemed|rsvp|booked|abandoned
  intent    String?
  sentiment String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  doc     SmartDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  visitor DocVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([docId, updatedAt])
  @@index([visitorId, updatedAt])
  @@index([channel, createdAt])
}

model DocScheduledMessage {
  id        String    @id @default(cuid())
  docId     String
  sendAt    DateTime
  channel   String    @default("web") // web|sms|email
  payload   Json?
  status    String    @default("pending") // pending|sent|failed|cancelled
  attempts  Int       @default(0)
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  doc SmartDocument @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, sendAt])
  @@index([status, sendAt])
}

model LoyaltyStamp {
  id         String        @id @default(cuid())
  docId      String
  visitorId  String
  stampedAt  DateTime      @default(now())
  redeemedAt DateTime?

  doc     SmartDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  visitor DocVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([docId, stampedAt])
  @@index([visitorId, stampedAt])
}

model PromoRedemption {
  id              String        @id @default(cuid())
  docId           String
  visitorId       String
  redeemedAt      DateTime      @default(now())
  discountApplied String?

  doc     SmartDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  visitor DocVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([docId, redeemedAt])
  @@index([visitorId, redeemedAt])
  @@map("DocumentPromoRedemption")
}

model EventRsvp {
  id        String        @id @default(cuid())
  docId     String
  visitorId String
  status    String        // attending|declined|maybe
  rsvpAt    DateTime      @default(now())

  doc     SmartDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  visitor DocVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([docId, rsvpAt])
  @@index([visitorId, rsvpAt])
}

model DocCheckIn {
  id          String        @id @default(cuid())
  docId       String
  visitorId   String
  checkedInAt DateTime      @default(now())
  note        String?

  doc     SmartDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  visitor DocVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([docId, checkedInAt])
  @@index([visitorId, checkedInAt])
}

model DocSignature {
  id           String        @id @default(cuid())
  docId        String
  visitorId    String
  signedAt     DateTime      @default(now())
  signatureUrl String?
  ipAddress    String?

  doc     SmartDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  visitor DocVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([docId, signedAt])
  @@index([visitorId, signedAt])
}

// PIL Phase B.1 — platform intelligence events (observe only; no execution).
model PilEvent {
  id         String   @id @default(cuid())
  type       String
  timestamp  DateTime @default(now())
  sessionId  String?
  userId     String?
  entityType String?
  entityId   String?
  storeId    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([type, timestamp])
  @@index([sessionId])
  @@index([userId])
  @@index([storeId, timestamp])
  @@index([entityType, entityId])
}

// PIL learning — skill dispatch telemetry + user classification feedback.
model SkillDispatchLog {
  id            String   @id @default(cuid())
  traceId       String
  userId        String?
  sessionId     String?
  query         String
  intent        String
  matchedSkill  String?
  confidence    Float
  executionPath String?
  outcome       String?
  latencyMs     Int?
  createdAt     DateTime @default(now())
  feedback      SkillDispatchFeedback[]

  @@index([userId, createdAt])
  @@index([intent, confidence])
  @@index([createdAt])
  @@index([traceId])
}

model SkillDispatchFeedback {
  id             String   @id @default(cuid())
  dispatchLogId  String
  userId         String?
  rating         Int
  correctionText String?
  createdAt      DateTime @default(now())

  dispatchLog SkillDispatchLog @relation(fields: [dispatchLogId], references: [id], onDelete: Cascade)

  @@index([dispatchLogId])
  @@index([userId])
}

// PIL learning Phase 3 — governed self-healing proposals from misroute detection.
model SelfHealingProposal {
  id                   String    @id @default(cuid())
  type                 String
  title                String
  description          String
  suggestedFix         Json
  metadata             Json
  status               String    @default("draft")
  requiresConfirmation Boolean   @default(true)
  occurrenceCount      Int       @default(1)
  lastSeen             DateTime  @default(now())
  appliedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

// PIL learning Phase 4 — adaptive pattern weights (governed adjustments only).
model PatternWeight {
  id                String   @id @default(cuid())
  patternId         String   @unique
  intent            String
  matchedSkill      String
  weight            Float    @default(1.0)
  adjustmentHistory Json
  lastAdjusted      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([intent])
  @@index([matchedSkill])
}

// Runtime observation bus — structured execution telemetry for learning + copilot.
model Observation {
  id              String   @id @default(cuid())
  missionId       String?
  intentType      String
  actionType      String
  executionState  String   @default("executed")
  isRealExecution Boolean  @default(true)
  outcome         String
  error           String?
  latency         Int?
  tokensUsed      Int?
  cost            Float?
  confidence      Float?
  contextSnapshot Json
  createdAt       DateTime @default(now())

  @@index([missionId])
  @@index([intentType, outcome])
  @@index([executionState])
  @@index([isRealExecution])
  @@index([createdAt])
  @@map("observations")
}

/// Batched frontend errors for self-diagnosis correlation with backend observations.
model FrontendError {
  id           String   @id @default(cuid())
  userId       String?
  sessionId    String
  type         String
  message      String
  filename     String?
  lineNumber   Int?
  columnNumber Int?
  stack        String?
  url          String?
  status       Int?
  metadata     String   @default("{}")
  timestamp    DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([type])
  @@index([timestamp])
  @@map("frontend_errors")
}

// Proactive copilot suggestions queue (governed client handoff; no auto-execute).
model CopilotSuggestion {
  id         String    @id @default(cuid())
  userId     String?
  storeId    String?
  type       String
  title      String
  message    String
  action     String
  urgency    String    @default("medium")
  priority   Int       @default(5)
  status     String    @default("pending")
  metadata   Json
  executedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, priority])
  @@index([createdAt])
  @@map("copilot_suggestions")
}

// Universal PIL Assistant — user memory and onboarding progress.
model UserMemory {
  id             String    @id @default(cuid())
  userId         String    @unique
  lastAction     String?
  lastActionAt   DateTime?
  visitCount     Int       @default(1)
  actionHistory  Json
  abandonedTasks Json
  completedTasks Json
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

model OnboardingProgress {
  id             String    @id @default(cuid())
  userId         String    @unique
  step           Int       @default(0)
  total          Int       @default(5)
  completedSteps Json
  lastStepAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

// Content acquisition pipeline — agent-discovered unclaimed stores
model UnclaimedStore {
  id              String    @id @default(cuid())
  slug            String    @unique
  businessName    String
  platform        String
  sourceUrl       String    @unique
  bioText         String?
  avatarUrl       String?
  followerCount   Int?
  category        String?
  location        String?
  brandTone       String?
  brandStyle      String?
  phone           String?
  email           String?
  address         String?
  hours           String?
  priceRange      String?
  websiteUrl      String?
  socialLinks     String?
  rawVideos       String?
  importHashtags  String?
  discoveryBatch  String?
  claimAuthority  String?
  status          String    @default("unclaimed")
  claimedBy       String?
  claimedAt       DateTime?
  preBuiltStoreId String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?

  @@index([status])
  @@index([platform])
  @@index([createdAt])
  @@index([discoveryBatch])
}

model DiscoverySeedSource {
  id         String    @id @default(cuid())
  type       String
  platform   String
  value      String
  location   String?
  category   String?
  isActive   Boolean   @default(true)
  priority   Int       @default(0)
  batchLimit Int?
  lastRunAt  DateTime?
  runCount   Int       @default(0)
  lastError  String?
  errorCount Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([isActive])
  @@index([type])
  @@index([priority])
}

model DiscoveryBatchRun {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  status         String    @default("running")
  seedSourceId   String?
  seedType       String?
  seedValue      String?
  discovered     Int       @default(0)
  scraped        Int       @default(0)
  created        Int       @default(0)
  skipped        Int       @default(0)
  failed         Int       @default(0)
  preBuilt       Int       @default(0)
  errorLog       String?
  triggeredBy    String?
  triggeredById  String?
  configSnapshot String?

  @@index([status])
  @@index([startedAt])
  @@index([seedSourceId])
}

// Singleton discovery agent configuration (one row only)
model DiscoveryConfig {
  id             String    @id @default(cuid())
  enabled        Boolean   @default(false)
  cronExpression String    @default("0 */6 * * *")
  batchSize      Int       @default(20)
  concurrency    Int       @default(3)
  delayMs        Int       @default(2000)
  maxRunsPerDay  Int       @default(4)
  pausedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
  updatedBy      String?
  createdAt      DateTime  @default(now())

  @@map("discovery_config")
}

// Phase 10 — Account knowledge vault (briefings, mission outputs, uploads, artifacts)
model SuitcaseItem {
  id              String   @id @default(cuid())
  ownerId         String
  spaceId         String?
  storeId         String?
  missionId       String?
  sourceType      String
  contentType     String
  title           String
  description     String?
  summary         String?
  tagsJson        String   @default("[]")
  metadataJson    String   @default("{}")
  fileUrl         String?
  thumbnailUrl    String?
  payloadJson     String?
  visibility      String   @default("private")
  embeddingStatus String   @default("pending")
  idempotencyKey  String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([ownerId, storeId])
  @@index([ownerId, sourceType])
  @@index([ownerId, missionId])
  @@index([ownerId, spaceId])
  @@map("suitcase_items")
}

// Phase 0 — Continuous conversation sessions (Performer console)
model ConversationSession {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  storeId         String?  @map("store_id")
  surface         String   @default("performer_console")
  status          String   @default("active")
  title           String?
  summary         String?
  messageCount    Int      @default(0) @map("message_count")
  lastMessageAt   DateTime @default(now()) @map("last_message_at")
  activeMissionId String?  @map("active_mission_id")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       ConversationMessage[]
  pendingActions ConversationPendingAction[]

  @@index([userId, status, lastMessageAt])
  @@index([storeId, lastMessageAt])
  @@map("conversation_sessions")
}

model ConversationMessage {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  missionId   String?  @map("mission_id")
  role        String
  content     String
  contentJson Json?    @map("content_json")
  toolCalls   Json?    @map("tool_calls")
  artifacts   Json?
  tokenCount  Int?     @map("token_count")
  sequence    Int
  createdAt   DateTime @default(now()) @map("created_at")

  session ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  mission MissionPipeline?    @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@unique([sessionId, sequence])
  @@index([sessionId, createdAt])
  @@index([missionId])
  @@map("conversation_messages")
}

model ConversationPendingAction {
  id             String    @id @default(cuid())
  sessionId      String    @map("session_id")
  kind           String
  proposedAction String?   @map("proposed_action")
  missionId      String?   @map("mission_id")
  stepId         String?   @map("step_id")
  payload        Json?     @map("payload_json")
  status         String    @default("pending")
  createdAt      DateTime  @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  session ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@map("conversation_pending_actions")
}

// Performer Context Engine — durable session memory (Phase A)
model PerformerSessionContext {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  sessionId   String    @map("session_id")
  active      Boolean   @default(true)
  contextJson String    @default("{}") @map("context_json")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  endedAt     DateTime? @map("ended_at")

  @@unique([userId, sessionId])
  @@index([userId, sessionId, active])
  @@map("performer_session_contexts")
}

// Phase D — Learning Layer (Reasoning-Native Architecture)
model UserProfile {
  userId                String   @id @map("user_id")
  preferredWorkflows    Json     @default("[]") @map("preferred_workflows")
  skippedSteps          Json     @default("[]") @map("skipped_steps")
  frequentlyUsedTools   Json     @default("[]") @map("frequently_used_tools")
  defaultAction         String?  @map("default_action")
  confidenceCalibration Json?    @map("confidence_calibration")
  learningEnabled       Boolean  @default(true) @map("learning_enabled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("learning_user_profiles")
}

model UserFeedback {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  sessionId  String   @map("session_id")
  type       String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  value      Int?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, sessionId])
  @@index([userId, type])
  @@index([targetType, targetId])
  @@map("learning_user_feedback")
}

model BehaviorPattern {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  pattern      String
  frequency    Int      @default(1)
  confidence   Float    @default(0.3)
  lastObserved DateTime @default(now()) @map("last_observed")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, pattern])
  @@index([userId])
  @@map("learning_behavior_patterns")
}

model GhostStoreClaim {
  id            String    @id @default(uuid())
  storeId       String
  claimantName  String
  claimantEmail String
  claimantPhone String?
  claimantRole  String?
  message       String?
  status        String    @default("pending")
  reviewerNote  String?
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?

  @@index([storeId])
  @@index([status])
  @@index([claimantEmail])
}

model GhostStoreReport {
  id        String   @id @default(uuid())
  storeId   String
  reason    String
  detail    String?
  status    String   @default("open")
  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([status])
}

model EnrichedFieldProvenance {
  id         String   @id @default(uuid())
  storeId    String
  fieldPath  String
  sourceUrl  String
  confidence Float
  fetchedAt  DateTime @default(now())

  @@index([storeId])
  @@index([fieldPath])
}

// ── Store Business Growth Center (owner-scoped CRM) ──

model BusinessLead {
  id              String    @id @default(cuid())
  ownerId         String
  storeId         String
  spaceId         String?
  name            String
  email           String?
  phone           String?
  source          String?
  status          String    @default("new")
  tags            Json?
  lastContactedAt DateTime?
  consentStatus   String    @default("unknown")
  notes           String?
  visitCount      Int       @default(0)
  interestedAt    DateTime?
  followUpDueAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  activities StoreLeadActivity[]

  @@index([ownerId])
  @@index([storeId])
  @@index([email])
  @@index([status])
  @@unique([storeId, email])
}

model StoreOutreachCampaign {
  id            String    @id @default(cuid())
  ownerId       String
  storeId       String
  name          String
  templateId    String
  templateBody  String?
  targetLeadIds Json?
  status        String    @default("draft")
  sentCount     Int       @default(0)
  failedCount   Int       @default(0)
  openCount     Int       @default(0)
  clickCount    Int       @default(0)
  replyCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([storeId])
  @@index([ownerId])
  @@index([status])
}

model StoreLeadActivity {
  id        String       @id @default(cuid())
  leadId    String
  lead      BusinessLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  storeId   String
  ownerId   String
  type      String
  message   String?
  metadata  Json?
  createdBy String?
  createdAt DateTime     @default(now())

  @@index([leadId])
  @@index([storeId])
  @@index([type])
  @@index([createdAt])
}

model ExecutiveLead {
  id               String   @id @default(cuid())
  businessName     String
  ownerName        String?
  email            String?
  phone            String?
  website          String?
  category         String?
  address          String?
  addressLine2     String?
  suburb           String?
  city             String?
  state            String?
  postcode         String?
  country          String?
  lat              Float?
  lng              Float?
  source           String?
  notes            String?
  consentStatus    String   @default("unknown") // unknown | granted | denied | pending
  leadStatus       String   @default("new")
  dataQualityScore Int      @default(0)
  draftStoreId     String?
  businessSeedId   String?
  storeId          String?
  lastContactedAt  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  activities LeadActivity[]

  @@index([email])
  @@index([leadStatus])
  @@index([city])
  @@index([category])
  @@index([source])
}

model GrowthBatch {
  id                String    @id @default(cuid())
  name              String
  missionType       String    @default("growth_acquisition_batch")
  source            String    @default("executive_overview")
  mode              String    @default("governed_batch")
  region            String?
  category          String?
  quantityRequested Int
  quantityCreated   Int       @default(0)
  autoCreateMode    String    @default("draft_only")
  requireReview     Boolean   @default(true)
  status            String    @default("pending") // pending | running | completed | failed | cancelled
  requestedBy       String?
  sourceLeadIds     Json?
  createdStoreIds   Json?
  reviewQueueIds    Json?
  auditSummary      Json?
  errorSummary      Json?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  @@index([status])
  @@index([requestedBy])
  @@index([createdAt])
}

model OutreachCampaign {
  id             String    @id @default(cuid())
  name           String
  templateId     String
  templateBody   String?
  targetLeadIds  Json?
  status         String    @default("draft") // draft | pending_confirm | sending | sent | failed
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  openCount      Int       @default(0)
  clickCount     Int       @default(0)
  replyCount     Int       @default(0)
  requestedBy    String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([status])
  @@index([createdAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      ExecutiveLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String   // import | status_change | email_sent | email_open | email_click | reply | note | batch_created
  message   String?
  metadata  Json?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([type])
  @@index([createdAt])
}
