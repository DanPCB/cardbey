# Copy to Render (or merge) as environment variables. Do not commit secrets.
#
# Pre-deploy checklist (Render service → Environment):
#   Required: NODE_ENV=production, DATABASE_URL=postgresql://..., JWT_SECRET, PUBLIC_BASE_URL, FRONTEND_URL,
#             OPENAI_API_KEY, XAI_API_KEY
#   Seeding / GTM (Phase 8): ANTHROPIC_API_KEY, LOGODEV_API_KEY, MAIL_HOST, MAIL_PORT, MAIL_USER, MAIL_PASS,
#             MAIL_FROM_EMAIL; CLAIM_OTP_LIVE_OUTREACH=false until intentional outreach
#   LLM routing: AGENT_LLM_PROVIDER, AGENT_LLM_MODEL, PERFORMER_INTAKE_*, PLANNER_TIMEOUT_MS (see below)
#   Feature flags: USE_LLM_TASK_PLANNER, ENABLE_OPENCLAW_AGENT_RUNTIME, OPENCLAW_MISSION_STEPS, LANGCHAIN_ENABLED,
#                  ENABLE_PROACTIVE_CAMPAIGN_RUNWAY, ENABLE_OPENCLAW_REAL_CAMPAIGN_APIS, ALLOW_CONCURRENT_MISSION_STEPS
#   CrewAI: CREWAI_ENABLED=false until Python/pip is on the build image (render.yaml pip step is non-fatal).
#
# Seeding deploy gate (presence only — never paste secrets into chat/logs):
#   cd apps/core/cardbey-core && node scripts/check-seeding-deploy-gate.mjs
#   On Render: Shell → same command; or Logs → look for [env] seeding-deploy-gate
#
# Post-deploy verification (first deploy):
#   1) Render logs: [SERVER] PUBLIC_BASE_URL: https://your-dashboard-domain.com
#      [ProactiveStep] agent dispatch mode: OpenClaw (OPENCLAW_MISSION_STEPS=true)
#      or dispatchTool if OpenClaw not enabled
#   2) curl https://your-api-domain.onrender.com/health
#   3) curl -X POST https://your-api-domain.onrender.com/api/performer/intake \
#        -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" \
#        -d '{"message": "Launch a marketing campaign"}'
#
# Prisma: this repo keeps separate schema files (prisma/postgres vs sqlite). On Render,
# set DATABASE_URL to a postgresql:// URL. The Render build command must run
# `npx prisma generate --schema prisma/postgres/schema.prisma` after npm install
# so the client in node_modules/.prisma/client-gen matches Postgres (see render.yaml).

# Core
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=...
FRONTEND_URL=https://your-dashboard.onrender.com
# Public URLs for QR codes and promo landing pages — use the dashboard (frontend) origin, not the API host.
PUBLIC_BASE_URL=https://your-dashboard.onrender.com

# LLM
OPENAI_API_KEY=...
AGENT_LLM_PROVIDER=xai
AGENT_LLM_MODEL=grok-3-beta
XAI_API_KEY=...
PERFORMER_INTAKE_LLM_MODEL=gpt-4o-mini
PERFORMER_INTAKE_LLM_PROVIDER=openai
PERFORMER_INTAKE_PLANNER_MODEL=gpt-4o-mini
PLANNER_TIMEOUT_MS=20000

# OpenClaw
ENABLE_OPENCLAW_AGENT_RUNTIME=true
OPENCLAW_MISSION_STEPS=true
OPENCLAW_APPROVALS_ENABLED=true
OPENCLAW_WEB_ENABLED=true
OPENCLAW_MEMORY_ENABLED=true
OPENCLAW_ORCHESTRATOR_AUTO_REFLECT_ON_FAILURE=true

# LangChain
LANGCHAIN_ENABLED=true

# CrewAI — false until Render build has Python/pip (Node images often lack pip; render.yaml pip is non-fatal)
CREWAI_ENABLED=false

# Feature flags
ENABLE_OPENCLAW_REAL_CAMPAIGN_APIS=true
USE_LLM_TASK_PLANNER=true
ENABLE_PROACTIVE_CAMPAIGN_RUNWAY=true
ENABLE_PERFORMER_INTAKE_V2_SHADOW=1

# Mission
ALLOW_CONCURRENT_MISSION_STEPS=true

# --- Seeding / claim OTP / enrichment (Phase 8 deploy gate) ---
# Required before Batch 0 re-enrich on Render and before live owner OTP.
ANTHROPIC_API_KEY=...
LOGODEV_API_KEY=...
MAIL_HOST=...
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=...
MAIL_PASS=...
MAIL_FROM_EMAIL=no-reply@cardbey.com
MAIL_FROM_NAME=Cardbey
# Keep false until staging re-audit + intentional GTM outreach
CLAIM_OTP_LIVE_OUTREACH=false
DEV_OTP_INBOX=dev@cardbey.com

# --- Multi-market discovery + prebuilt store V1 (KEEP OFF until staging pilot approval) ---
# ENABLE_MULTI_MARKET_DISCOVERY_V1=false
# ENABLE_AUSTRALIA_DISCOVERY_V1=false
# ENABLE_VIETNAM_DISCOVERY_V1=false
# ENABLE_PREBUILT_STORE_DRAFTS_V1=false
# ENABLE_PREBUILT_STORE_AI_SUGGESTIONS_V1=false
# ENABLE_BUSINESS_CLAIM_V1=false
# ENABLE_PUBLIC_UNCLAIMED_BUSINESS_CARDS_V1=false
# ENABLE_PUBLIC_UNCLAIMED_CARD_INDEXING_V1=false

# Ghost store owner for activate path (one of these)
DISCOVERY_SYSTEM_USER_ID=...
# INGESTION_SYSTEM_USER_ID=...

# KLING_* optional for MVP seeding (video) — not required for Batch 0 claim funnel

# Render: prefer `npm start` (not raw `node src/server.js`) so `prestart` runs Prisma bootstrap.

# Object storage (Cloudflare R2) — new uploads persist outside Render ephemeral disk.
# Local dev: omit STORAGE_DRIVER (defaults to local /uploads).
STORAGE_DRIVER=s3
S3_REGION=auto
S3_BUCKET=cardbey-media
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
# Public CDN hostname (attach custom domain in R2 → Settings → Custom Domains)
MEDIA_PUBLIC_BASE_URL=https://media.cardbey.com

# --- Cardbey Live Market / Global Live (all default OFF) ---
# ENABLE_LIVE_MARKET_V1=false
# ENABLE_LIVE_MARKET_OWNER_V1=false
# ENABLE_LIVE_MARKET_ADMIN_V1=false
# ENABLE_LIVE_MARKET_PUBLIC_V1=false
# ENABLE_LIVE_MARKET_STOREFRONT_PUBLISH_V1=false
# ENABLE_LIVE_MARKET_STOREFRONT_CONSUME_V1=false
# ENABLE_LIVE_MARKET_GLOBAL_FEED_V1=false
# ENABLE_LIVE_MARKET_REGISTRATION_V1=false
# ENABLE_LIVE_MARKET_REGISTRATION_SUMMARY_V1=false
# ENABLE_LIVE_MARKET_HOST_PARTICIPANTS_V1=false
# ENABLE_LIVE_BROADCAST_V1=false
# ENABLE_LIVE_CLOUDFLARE_STREAM_V1=false
# ENABLE_LIVE_CLOUDFLARE_WEBRTC_V1=false
# ENABLE_GLOBAL_LIVE_EOI_V1=false
# GLOBAL_LIVE_EOI_OPEN=false
# ENABLE_GLOBAL_LIVE_EOI_CONFIRMATIONS=true
# ENABLE_GLOBAL_LIVE_EOI_CONFIRMATION_EMAIL_V2=false
# ENABLE_GLOBAL_LIVE_EOI_APPLICANT_TRACKING_V1=false
# ENABLE_GLOBAL_LIVE_EOI_CONFIRMATION_SMS=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# ENABLE_SMS=false