# Runtime Kernel — Staging flag enablement (progressive rollout)
# Copy relevant sections to Render cardbey-core-staging Environment (or local .env).
# Advance one phase at a time; run soak after each phase:
#   node scripts/runtime-kernel-staging-soak.mjs
#
# Rollback: disable flags in reverse order (E → D → C → B); restart API.
# See docs/RUNTIME_KERNEL_STAGING_SOAK.md

# ---------------------------------------------------------------------------
# Phase 0 — Foundation (required before Phase B+)
# Enable first; validate step execution + capabilities negotiation.
# ---------------------------------------------------------------------------
ENABLE_PERFORMER_RUNTIME_KERNEL=true
ENABLE_RUNTIME_STEP_EXECUTION=true
ENABLE_SHARED_RUNTIME_TOOL_REGISTRY=true
ENABLE_PROACTIVE_CAMPAIGN_RUNWAY=true

# Recommended supporting flags for Performer staging
ENABLE_RUNTIME_SESSION_REHYDRATION=true
ENABLE_RUNTIME_STORE_FALLBACK=true
PERFORMER_RUNTIME_UNIFIED_STREAM=true

# ---------------------------------------------------------------------------
# Phase B — Mission Orchestrator (backend proactive sequencing)
# Requires Foundation. Dashboard uses runtimeMissionOrchestrator capability.
# Enabled on cardbey-core-staging via render.yaml (2026-05-31).
# ---------------------------------------------------------------------------
ENABLE_RUNTIME_MISSION_ORCHESTRATOR=true

# ---------------------------------------------------------------------------
# Phase C — Mission Graph Runtime
# Requires Phase B. Graph persists in metadataJson.runtimeMissionGraph.
# ---------------------------------------------------------------------------
# ENABLE_RUNTIME_MISSION_GRAPH=true
# ENABLE_RUNTIME_GRAPH_SCHEDULER=true

# ---------------------------------------------------------------------------
# Phase D — Skill / Worker Runtime
# Requires Phase C. Workers + leases in metadataJson.runtimeWorkerState.
# ---------------------------------------------------------------------------
# ENABLE_RUNTIME_SKILL_RUNTIME=true
# ENABLE_RUNTIME_WORKER_MANAGER=true
# ENABLE_RUNTIME_EXECUTION_LEASES=true

# ---------------------------------------------------------------------------
# Phase E — Durable Queue + Recovery
# Requires Phase D. Queue in metadataJson.runtimeExecutionQueue.
# ---------------------------------------------------------------------------
# ENABLE_RUNTIME_EXECUTION_QUEUE=true
# ENABLE_RUNTIME_LEASE_RECOVERY=true
# ENABLE_RUNTIME_REPLAY_PROTECTION=true
# ENABLE_RUNTIME_HEARTBEAT_MONITOR=true

# ---------------------------------------------------------------------------
# Full Runtime Kernel stack (DO NOT enable all at once)
# Enable only after each phase B→C→D→E passes soak independently.
# See docs/RUNTIME_KERNEL_STAGING_SOAK.md
# ---------------------------------------------------------------------------
# ENABLE_RUNTIME_MISSION_ORCHESTRATOR=true
# ENABLE_RUNTIME_MISSION_GRAPH=true
# ENABLE_RUNTIME_GRAPH_SCHEDULER=true
# ENABLE_RUNTIME_SKILL_RUNTIME=true
# ENABLE_RUNTIME_WORKER_MANAGER=true
# ENABLE_RUNTIME_EXECUTION_LEASES=true
# ENABLE_RUNTIME_EXECUTION_QUEUE=true
# ENABLE_RUNTIME_LEASE_RECOVERY=true
# ENABLE_RUNTIME_REPLAY_PROTECTION=true
# ENABLE_RUNTIME_HEARTBEAT_MONITOR=true

# ---------------------------------------------------------------------------
# Phase F Step 1 — Legacy bypass closure (orchestra/start + missionId)
# Lowest-risk closure; does not affect intake V2 or draft-store routes.
# Rollback: BROKER_BLOCK_ORCHESTRA_WITH_MISSION=false
# See docs/IMPACT_REPORT_PHASE_F_LEGACY_BYPASS.md
# ---------------------------------------------------------------------------
PHASE_F_BYPASS_TELEMETRY=true
BROKER_BLOCK_ORCHESTRA_WITH_MISSION=true
# Keep OFF until Step 1 soak passes:
# PHASE_F_ROUTE_MCP_VIA_FACADE=false
# PHASE_F_BLOCK_MCP_DIRECT_DISPATCH=false
# PHASE_F_BLOCK_PROACTIVE_STEP_LEGACY=false
# PHASE_F_BLOCK_DRAFT_STORE_RUNWAY=false

# Audit: pnpm --filter @cardbey/core audit:phase-f-bypass
# curl https://cardbey-core-staging.onrender.com/api/broker/phase-f-bypass

# Soak script overrides (optional)
# API_BASE=https://cardbey-core-staging.onrender.com
# EXPECTED_RUNTIME_KERNEL_STAGE=PHASE_B
# SOAK_USER_ID=
# SOAK_STORE_ID=
